{
  "components": [
    {
      "text": "### User Information",
      "type": "text",
      "id": "Heading_User_Info",
      "layout": {
        "row": "Row_1",
        "col": 16
      }
    },
    {
      "label": "Full Name",
      "type": "textfield",
      "id": "Textfield_FullName",
      "key": "fullName",
      "layout": {
        "row": "Row_2",
        "col": 16
      },
      "validate": {
        "required": true,
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      }
    },
    {
      "label": "Email Address",
      "type": "textfield",
      "id": "Textfield_Email",
      "key": "email",
      "layout": {
        "row": "Row_3",
        "col": 8
      },
      "validate": {
        "required": true,
        "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
        "maxLength": 255
      }
    },
    {
      "label": "Phone Number",
      "type": "textfield",
      "id": "Textfield_Phone",
      "key": "phoneNumber",
      "layout": {
        "row": "Row_3",
        "col": 8
      },
      "validate": {
        "required": true,
        "pattern": "^[\\+]?[\\d\\s\\-\\(\\)]{7,15}$",
        "maxLength": 255
      }
    },
    {
      "text": "### Shipping Address",
      "type": "text",
      "id": "Heading_Shipping_Address",
      "layout": {
        "row": "Row_9",
        "col": 16
      }
    },
    {
      "label": "Street Address",
      "type": "textfield",
      "id": "Textfield_Shipping_Street",
      "key": "shippingStreet",
      "layout": {
        "row": "Row_11",
        "col": 16
      },
      "validate": {
        "required": true
      }
    },
    {
      "label": "Apartment, suite, etc.",
      "type": "textfield",
      "id": "Textfield_Shipping_Apt",
      "key": "shippingApt",
      "layout": {
        "row": "Row_12",
        "col": 16
      },
      "validate": {
        "required": true,
        "maxLength": 255
      }
    },
    {
      "label": "City",
      "type": "textfield",
      "id": "Textfield_Shipping_City",
      "key": "shippingCity",
      "layout": {
        "row": "Row_13",
        "col": 6
      },
      "validate": {
        "required": true,
        "maxLength": 50,
        "pattern": "^[A-Za-z\\s\\-']+$"
      }
    },
    {
      "label": "State / Province",
      "type": "textfield",
      "id": "Textfield_Shipping_State",
      "key": "shippingState",
      "layout": {
        "row": "Row_13",
        "col": 5
      },
      "validate": {
        "required": true,
        "minLength": 2,
        "maxLength": 2,
        "pattern": "^[A-Z]{2}$"
      }
    },
    {
      "label": "Postal / ZIP Code",
      "type": "textfield",
      "id": "Textfield_Shipping_Zip",
      "key": "shippingZip",
      "layout": {
        "row": "Row_13",
        "col": 5
      },
      "validate": {
        "required": true,
        "pattern": "^\\d{5}(\\-\\d{4})?$",
        "maxLength": 255
      }
    },
    {
      "label": "Country",
      "values": [
        {
          "label": "United States",
          "value": "US"
        },
        {
          "label": "Canada",
          "value": "CA"
        },
        {
          "label": "Mexico",
          "value": "MX"
        },
        {
          "label": "Germany",
          "value": "DE"
        },
        {
          "label": "United Kingdom",
          "value": "GB"
        }
      ],
      "type": "select",
      "id": "Select_Shipping_Country",
      "key": "shippingCountry",
      "layout": {
        "row": "Row_14",
        "col": 16
      },
      "validate": {
        "required": true
      }
    },
    {
      "text": "### Payment Information",
      "type": "text",
      "id": "Heading_Payment_Info",
      "layout": {
        "row": "Row_15",
        "col": 16
      }
    },
    {
      "label": "Name on Card",
      "type": "textfield",
      "id": "Textfield_Card_Name",
      "key": "cardName",
      "layout": {
        "row": "Row_16",
        "col": 16
      },
      "validate": {
        "required": true,
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      }
    },
    {
      "label": "Card Number",
      "type": "textfield",
      "id": "Textfield_Card_Number",
      "key": "cardNumber",
      "layout": {
        "row": "Row_17",
        "col": 16
      },
      "validate": {
        "required": true,
        "minLength": 13,
        "maxLength": 19,
        "pattern": "^[0-9\\s]{13,19}$"
      }
    },
    {
      "label": "Expiration Date (MM/YY)",
      "type": "textfield",
      "id": "Textfield_Card_Expiry",
      "key": "cardExpiry",
      "layout": {
        "row": "Row_18",
        "col": 8
      },
      "validate": {
        "required": true,
        "pattern": "^(0[1-9]|1[0-2])\\/\\d{2}$",
        "maxLength": 255
      }
    },
    {
      "label": "Security Code (CVV)",
      "type": "textfield",
      "id": "Textfield_Card_CVV",
      "key": "cardCvv",
      "layout": {
        "row": "Row_18",
        "col": 8
      },
      "validate": {
        "required": true,
        "minLength": 3,
        "maxLength": 4,
        "pattern": "^[0-9]{3,4}$"
      }
    },
    {
      "label": "Use Member Financing?",
      "type": "checkbox",
      "layout": {
        "row": "Row_14xpv4f",
        "columns": null
      },
      "id": "Field_1i8duyq",
      "key": "useLoan"
    },
    {
      "label": "Submit",
      "action": "submit",
      "type": "button",
      "id": "Button_Submit",
      "layout": {
        "row": "Row_19",
        "col": 16
      }
    }
  ],
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.44.0"
  },
  "schemaVersion": 19,
  "id": "prompt-user-for-information-and-payment-info-form",
  "generated": true,
  "type": "default"
}