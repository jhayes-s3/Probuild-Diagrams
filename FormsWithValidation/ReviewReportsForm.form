{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "35a6d3d"
  },
  "schemaVersion": 19,
  "id": "review-reports-form",
  "components": [
    {
      "text": "### Review Report Form",
      "type": "text",
      "id": "Heading_main",
      "layout": {
        "row": "row_0",
        "col": 16
      }
    },
    {
      "text": "##### Report Details",
      "type": "text",
      "id": "Subheading_report_details",
      "layout": {
        "row": "row_1",
        "col": 16
      }
    },
    {
      "label": "Report ID",
      "type": "textfield",
      "id": "Field_reportId",
      "key": "reportId",
      "validate": {
        "required": true,
        "maxLength": 60,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-_/# ]{1,59}$",
        "minLength": 2
      },
      "layout": {
        "row": "row_2",
        "col": 8
      }
    },
    {
      "label": "Report Title",
      "type": "textfield",
      "id": "Field_reportTitle",
      "key": "reportTitle",
      "validate": {
        "required": true,
        "maxLength": 255,
        "minLength": 2
      },
      "layout": {
        "row": "row_2",
        "col": 8
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Field_dateOfReview",
      "key": "dateOfReview",
      "dateLabel": "Date of Review",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_3",
        "col": 16
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Field_reviewPeriodStart",
