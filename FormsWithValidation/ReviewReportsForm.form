      "id": "Subheading_assessment",
      "layout": {
        "row": "row_13",
        "col": 16
      }
    },
    {
      "label": "Criteria/Category",
      "values": [
        {
          "label": "Performance",
          "value": "performance"
        },
        {
          "label": "Quality",
          "value": "quality"
        },
        {
          "label": "Compliance",
          "value": "compliance"
        },
        {
          "label": "Teamwork",
          "value": "teamwork"
        }
      ],
      "type": "select",
      "id": "Field_criteriaCategory",
      "key": "criteriaCategory",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_14",
        "col": 8
      }
    },
    {
      "label": "Rating/Score",
      "values": [
        {
          "label": "Exceeds Expectations",
          "value": "exceeds"
        },
        {
          "label": "Meets Expectations",
          "value": "meets"
        },
        {
          "label": "Below Expectations",
          "value": "below"
        }
      ],
      "type": "select",
      "id": "Field_ratingScore",
      "key": "ratingScore",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_14",
        "col": 8
