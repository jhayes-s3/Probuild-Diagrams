      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_4",
        "col": 16
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Field_reviewPeriodEnd",
      "key": "reviewPeriodEnd",
      "dateLabel": "Review Period End Date",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_5",
        "col": 16
      }
    },
    {
      "text": "##### Reviewer Information",
      "type": "text",
      "id": "Subheading_reviewer_info",
