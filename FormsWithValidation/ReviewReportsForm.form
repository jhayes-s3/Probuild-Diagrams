        "row": "row_6",
        "col": 16
      }
    },
    {
      "label": "Reviewer Name",
      "type": "textfield",
      "id": "Field_reviewerName",
      "key": "reviewerName",
      "validate": {
        "required": true,
        "maxLength": 255,
        "pattern": "^[A-Za-z][A-Za-z\\s\\-']{1,99}$",
        "minLength": 2
      },
      "layout": {
        "row": "row_7",
        "col": 8
      }
    },
    {
      "label": "Reviewer Title/Role",
      "type": "textfield",
      "id": "Field_reviewerTitle",
      "key": "reviewerTitle",
      "validate": {
        "required": true,
        "maxLength": 255,
        "minLength": 2
      },
      "layout": {
        "row": "row_7",
        "col": 8
      }
    },
    {
      "label": "Reviewer Department",
