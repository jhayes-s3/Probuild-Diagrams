      "id": "Field_subjectName",
      "key": "subjectName",
      "validate": {
        "required": true,
        "maxLength": 255
      },
      "layout": {
        "row": "row_11",
        "col": 8
      }
    },
    {
      "label": "Subject ID (e.g., Employee ID, Project Code)",
