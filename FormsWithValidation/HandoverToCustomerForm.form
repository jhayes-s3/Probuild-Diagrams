{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "35a6d3d"
  },
  "schemaVersion": 19,
  "id": "hand-over-to-customer-form",
  "components": [
    {
      "text": "### Handover Details",
      "type": "text",
      "id": "Heading_handoverDetails",
      "layout": {
        "row": "row_1",
        "col": 16
      }
    },
    {
      "label": "Handover ID / Reference Number",
      "type": "textfield",
      "id": "Field_handoverId",
      "key": "handoverId",
      "layout": {
        "row": "row_2",
        "col": 8
      },
      "validate": {
        "required": true,
        "minLength": 1,
        "maxLength": 50,
        "pattern": "^[A-Za-z0-9\\-]+$"
      }
    },
    {
      "label": "Warehouse Location / Pickup Point",
      "type": "textfield",
      "id": "Field_warehouseLocation",
      "key": "warehouseLocation",
      "layout": {
        "row": "row_2",
        "col": 8
      },
      "validate": {
        "required": true,
        "maxLength": 255
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Field_handoverDate",
      "key": "handoverDate",
      "dateLabel": "Date of Handover",
      "layout": {
        "row": "row_3",
        "col": 16
      },
      "validate": {
        "required": true
      }
    },
    {
      "subtype": "time",
      "type": "datetime",
      "id": "Field_handoverTime",
      "key": "handoverTime",
      "timeLabel": "Time of Handover",
      "layout": {
        "row": "row_4",
        "col": 16
      },
      "validate": {
        "required": true
      },
      "timeInterval": 15
    },
    {
      "text": "### Customer & Order Information",
      "type": "text",
      "id": "Heading_customerInfo",
      "layout": {
        "row": "row_5",
        "col": 16
      }
    },
    {
      "label": "Customer Name",
      "type": "textfield",
      "id": "Field_customerName",
      "key": "customerName",
      "layout": {
        "row": "row_6",
        "col": 8
      },
      "validate": {
        "required": true,
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      }
    },
    {
      "label": "Customer ID / Account Number",
      "type": "textfield",
      "id": "Field_customerId",
      "key": "customerId",
      "layout": {
        "row": "row_6",
        "col": 8
      },
      "validate": {
        "required": true,
        "minLength": 1,
        "maxLength": 50,
        "pattern": "^[A-Za-z0-9\\-]+$"
      }
    },
    {
      "label": "Order Number",
      "type": "textfield",
      "id": "Field_orderNumber",
      "key": "orderNumber",
      "layout": {
        "row": "row_7",
        "col": 8
      },
      "validate": {
        "required": true,
        "minLength": 1,
        "maxLength": 50,
        "pattern": "^[A-Za-z0-9\\-]+$"
      }
    },
    {
      "label": "Customer Contact Phone Number",
      "type": "textfield",
      "id": "Field_customerPhone",
      "key": "customerPhone",
      "layout": {
        "row": "row_7",
        "col": 8
      },
      "validate": {
        "required": true,
        "pattern": "^[\\+]?[\\d\\s\\-\\(\\)]{7,15}$",
        "maxLength": 255
      }
    },
    {
      "text": "### Item Details",
      "type": "text",
      "id": "Heading_itemDetails",
      "layout": {
        "row": "row_8",
        "col": 16
      }
    },
    {
      "text": "The fields below are for a single item. In a real application, this section would be a repeatable list to capture multiple items.",
      "type": "text",
      "id": "Para_itemDetailsInfo",
      "layout": {
        "row": "row_9",
        "col": 16
      }
    },
    {
      "label": "Product SKU / Item Code",
      "type": "textfield",
      "id": "Field_productSku",
      "key": "items[0].productSku",
      "layout": {
        "row": "row_10",
        "col": 8
      },
      "validate": {
        "required": true,
        "minLength": 1,
        "maxLength": 50,
        "pattern": "^[A-Za-z0-9\\-]+$"
      }
    },
    {
      "label": "Product Description",
      "type": "textfield",
      "id": "Field_productDescription",
      "key": "items[0].productDescription",
      "layout": {
        "row": "row_10",
        "col": 8
      }
    },
    {
      "label": "Quantity Expected",
      "type": "number",
      "id": "Field_quantityExpected",
      "key": "items[0].quantityExpected",
      "layout": {
        "row": "row_11",
        "col": 4
      },
      "validate": {
        "required": true,
        "min": 0
      }
    },
    {
      "label": "Quantity Handed Over",
      "type": "number",
      "id": "Field_quantityHandedOver",
      "key": "items[0].quantityHandedOver",
      "layout": {
        "row": "row_11",
        "col": 4
      },
      "validate": {
        "required": true,
        "min": 0
      }
    },
    {
      "label": "Unit of Measure",
      "values": [
        {
          "label": "Piece",
          "value": "piece"
        },
        {
          "label": "Box",
          "value": "box"
        },
        {
          "label": "Pallet",
          "value": "pallet"
        }
      ],
      "type": "select",
      "id": "Field_unitOfMeasure",
      "key": "items[0].unitOfMeasure",
      "layout": {
        "row": "row_11",
        "col": 4
      },
      "validate": {
        "required": true
      }
    },
    {
      "label": "Condition Check",
      "values": [
        {
          "label": "Good",
          "value": "good"
        },
        {
          "label": "Damaged",
          "value": "damaged"
        },
        {
          "label": "Scratched",
          "value": "scratched"
        }
      ],
      "type": "select",
      "id": "Field_conditionCheck",
      "key": "items[0].conditionCheck",
      "layout": {
        "row": "row_11",
        "col": 4
      },
      "validate": {
        "required": true
      }
    },
    {
      "label": "Batch / Lot Number (if applicable)",
      "type": "textfield",
      "id": "Field_batchLotNumber",
      "key": "items[0].batchLotNumber",
      "layout": {
        "row": "row_12",
        "col": 16
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "Serial Number(s) (if applicable)",
      "values": [
        {
          "label": "Value",
          "value": "value"
        }
      ],
      "type": "taglist",
      "id": "Field_serialNumbers",
      "key": "items[0].serialNumbers",
      "layout": {
        "row": "row_13",
        "col": 16
      }
    },
    {
      "text": "### Verification",
      "type": "text",
      "id": "Heading_verification",
      "layout": {
        "row": "row_14",
        "col": 16
      }
    },
    {
      "label": "Type of ID Presented by Customer",
      "values": [
        {
          "label": "Driver's License",
          "value": "drivers_license"
        },
        {
          "label": "Passport",
          "value": "passport"
        },
        {
          "label": "National ID",
          "value": "national_id"
        }
      ],
      "type": "select",
      "id": "Field_idType",
      "key": "idType",
      "layout": {
        "row": "row_15",
        "col": 8
      },
      "validate": {
        "required": true
      }
    },
    {
      "label": "ID Number (last 4 digits)",
      "type": "textfield",
      "id": "Field_idNumberLast4",
      "key": "idNumberLast4",
      "layout": {
        "row": "row_15",
        "col": 8
      },
      "validate": {
        "required": true,
        "minLength": 4,
        "maxLength": 4,
        "pattern": "^\\d{4}$"
      }
    },
    {
      "text": "### Personnel Details",
      "type": "text",
      "id": "Heading_personnel",
      "layout": {
        "row": "row_16",
        "col": 16
      }
    },
    {
      "label": "Warehouse Staff Name",
      "type": "textfield",
      "id": "Field_staffName",
      "key": "staffName",
      "layout": {
        "row": "row_17",
        "col": 8
      },
      "validate": {
        "required": true,
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      }
    },
    {
      "label": "Warehouse Staff ID",
      "type": "textfield",
      "id": "Field_staffId",
      "key": "staffId",
      "layout": {
        "row": "row_17",
        "col": 8
      },
      "validate": {
        "required": true,
        "minLength": 1,
        "maxLength": 50,
        "pattern": "^[A-Za-z0-9\\-]+$"
      }
    },
    {
      "text": "### Acknowledgment & Signatures",
      "type": "text",
      "id": "Heading_acknowledgment",
      "layout": {
        "row": "row_18",
        "col": 16
      }
    },
    {
      "label": "Customer Signature",
      "type": "textfield",
      "id": "Field_customerSignature",
      "key": "customerSignature",
      "description": "Type full name to acknowledge receipt of the items.",
      "layout": {
        "row": "row_19",
        "col": 8
      },
      "validate": {
        "required": true,
        "minLength": 2,
        "maxLength": 100
      }
    },
    {
      "label": "Customer Printed Name",
      "type": "textfield",
      "id": "Field_customerPrintedName",
      "key": "customerPrintedName",
      "layout": {
        "row": "row_19",
        "col": 8
      },
      "validate": {
        "required": true,
        "maxLength": 255
      }
    },
    {
      "label": "Warehouse Staff Signature",
      "type": "textfield",
      "id": "Field_staffSignature",
      "key": "staffSignature",
      "description": "Type full name to confirm handover.",
      "layout": {
        "row": "row_20",
        "col": 8
      },
      "validate": {
        "required": true,
        "minLength": 2,
        "maxLength": 100
      }
    },
    {
      "subtype": "datetime",
      "type": "datetime",
      "id": "Field_signatureTimestamp",
      "key": "signatureTimestamp",
      "dateLabel": "Date of Signature",
      "timeLabel": "Time of Signature",
      "layout": {
        "row": "row_20",
        "col": 8
      },
      "validate": {
        "required": true
      },
      "timeInterval": 15
    },
    {
      "label": "Notes / Discrepancy Report",
      "type": "textarea",
      "id": "Field_notes",
      "key": "notes",
      "layout": {
        "row": "row_21",
        "col": 16
      }
    }
  ],
  "generated": true,
  "type": "default"
}