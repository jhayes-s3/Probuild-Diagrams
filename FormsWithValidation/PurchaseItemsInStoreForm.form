{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "35a6d3d"
  },
  "schemaVersion": 19,
  "id": "purchase-items-in-store",
  "components": [
    {
      "text": "### Customer Information",
      "type": "text",
      "id": "CustomerInfoHeading",
      "layout": {
        "row": "row_1",
        "col": 16
      }
    },
    {
      "label": "First Name",
      "type": "textfield",
      "id": "FirstNameField",
      "key": "customerFirstName",
      "validate": {
        "required": true,
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      },
      "layout": {
        "row": "row_2",
        "col": 8
      }
    },
    {
      "label": "Last Name",
      "type": "textfield",
      "id": "LastNameField",
      "key": "customerLastName",
      "validate": {
        "required": true,
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      },
      "layout": {
        "row": "row_2",
        "col": 8
      }
    },
    {
      "label": "Company Name (if applicable)",
      "type": "textfield",
      "id": "CompanyNameField",
      "key": "companyName",
      "layout": {
        "row": "row_3",
        "col": 8
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "ProBuild Account Number",
      "type": "textfield",
      "id": "AccountNumberField",
      "key": "proBuildAccountNumber",
      "layout": {
        "row": "row_3",
        "col": 8
      },
      "validate": {
        "minLength": 1,
        "maxLength": 50,
        "pattern": "^[A-Za-z0-9\\-]+$"
      }
    },
    {
      "label": "Contact Phone Number",
      "type": "textfield",
      "id": "PhoneField",
      "key": "contactPhoneNumber",
      "validate": {
        "required": true,
        "pattern": "^[\\+]?[\\d\\s\\-\\(\\)]{7,15}$",
        "maxLength": 255
      },
      "layout": {
        "row": "row_4",
        "col": 8
      }
    },
    {
      "label": "Email Address",
      "type": "textfield",
      "id": "EmailField",
      "key": "emailAddress",
      "validate": {
        "required": true,
        "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
      },
      "layout": {
        "row": "row_4",
        "col": 8
      }
    },
    {
      "label": "Billing Address",
      "type": "textarea",
      "id": "BillingAddressField",
      "key": "billingAddress",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_5",
        "col": 16
      }
    },
    {
      "label": "Shipping Address",
      "type": "textarea",
      "id": "ShippingAddressField",
      "key": "shippingAddress",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_6",
        "col": 16
      }
    },
    {
      "text": "### Order Details",
      "type": "text",
      "id": "OrderDetailsHeading",
      "layout": {
        "row": "row_7",
        "col": 16
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "OrderDateField",
      "key": "orderDate",
      "dateLabel": "Order Date",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_8",
        "col": 16
      }
    },
    {
      "label": "Purchase Order Number (if applicable)",
      "type": "textfield",
      "id": "PoNumberField",
      "key": "purchaseOrderNumber",
      "layout": {
        "row": "row_9",
        "col": 5
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "Sales Representative ID",
      "type": "textfield",
      "id": "SalesRepIdField",
      "key": "salesRepresentativeId",
      "layout": {
        "row": "row_9",
        "col": 5
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "Store/Branch Location",
      "type": "textfield",
      "id": "StoreLocationField",
      "key": "storeBranchLocation",
      "layout": {
        "row": "row_9",
        "col": 6
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "text": "### Purchased Items",
      "type": "text",
      "id": "ItemsHeading",
      "layout": {
        "row": "row_10",
        "col": 16
      }
    },
    {
      "text": "This form represents a single item. In a full application, this would be a repeatable list of items.",
      "type": "text",
      "id": "ItemsInfo",
      "layout": {
        "row": "row_11",
        "col": 16
      }
    },
    {
      "label": "Item SKU / Product Code",
      "type": "textfield",
      "id": "ItemSkuField",
      "key": "items[0].sku",
      "layout": {
        "row": "row_12",
        "col": 8
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "Item Description",
      "type": "textfield",
      "id": "ItemDescriptionField",
      "key": "items[0].description",
      "layout": {
        "row": "row_12",
        "col": 8
      }
    },
    {
      "label": "Quantity",
      "type": "number",
      "id": "QuantityField",
      "key": "items[0].quantity",
      "layout": {
        "row": "row_13",
        "col": 5
      },
      "validate": {
        "min": 0
      }
    },
    {
      "label": "Unit Price",
      "type": "number",
      "id": "UnitPriceField",
      "key": "items[0].unitPrice",
      "appearance": {
        "prefixAdorner": "$"
      },
      "decimalDigits": 2,
      "layout": {
        "row": "row_13",
        "col": 5
      },
      "validate": {
        "min": 0
      }
    },
    {
      "label": "Line Item Total",
      "type": "number",
      "id": "LineItemTotalField",
      "key": "items[0].lineItemTotal",
      "appearance": {
        "prefixAdorner": "$"
      },
      "decimalDigits": 2,
      "layout": {
        "row": "row_13",
        "col": 6
      },
      "validate": {
        "min": 0
      }
    },
    {
      "text": "### Payment Information",
      "type": "text",
      "id": "PaymentInfoHeading",
      "layout": {
        "row": "row_14",
        "col": 16
      }
    },
    {
      "label": "Subtotal",
      "type": "number",
      "id": "SubtotalField",
      "key": "subtotal",
      "appearance": {
        "prefixAdorner": "$"
      },
      "decimalDigits": 2,
      "layout": {
        "row": "row_15",
        "col": 4
      },
      "validate": {
        "min": 0
      }
    },
    {
      "label": "Sales Tax",
      "type": "number",
      "id": "TaxField",
      "key": "salesTax",
      "appearance": {
        "prefixAdorner": "$"
      },
      "decimalDigits": 2,
      "layout": {
        "row": "row_15",
        "col": 4
      },
      "validate": {
        "min": 0
      }
    },
    {
      "label": "Shipping/Delivery Fee",
      "type": "number",
      "id": "ShippingFeeField",
      "key": "shippingDeliveryFee",
      "appearance": {
        "prefixAdorner": "$"
      },
      "decimalDigits": 2,
      "layout": {
        "row": "row_15",
        "col": 4
      },
      "validate": {
        "min": 0
      }
    },
    {
      "label": "Total Amount",
      "type": "number",
      "id": "TotalAmountField",
      "key": "totalAmount",
      "appearance": {
        "prefixAdorner": "$"
      },
      "decimalDigits": 2,
      "validate": {
        "required": true,
        "min": 0
      },
      "layout": {
        "row": "row_15",
        "col": 4
      }
    },
    {
      "label": "Payment Method",
      "values": [
        {
          "label": "Credit Card",
          "value": "creditCard"
        },
        {
          "label": "On Account",
          "value": "onAccount"
        },
        {
          "label": "Check",
          "value": "check"
        },
        {
          "label": "Cash",
          "value": "cash"
        }
      ],
      "type": "select",
      "id": "PaymentMethodField",
      "key": "paymentMethod",
      "layout": {
        "row": "row_16",
        "col": 8
      }
    },
    {
      "label": "Transaction ID",
      "type": "textfield",
      "id": "TransactionIdField",
      "key": "transactionId",
      "layout": {
        "row": "row_16",
        "col": 8
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "Credit Card Number",
      "type": "textfield",
      "id": "CcNumberField",
      "key": "creditCardNumber",
      "layout": {
        "row": "row_17",
        "col": 8
      },
      "validate": {
        "required": true,
        "minLength": 13,
        "maxLength": 19,
        "pattern": "^[0-9\\s]{13,19}$"
      }
    },
    {
      "label": "Expiration Date (MM/YY)",
      "type": "textfield",
      "id": "CcExpirationField",
      "key": "creditCardExpiration",
      "layout": {
        "row": "row_17",
        "col": 8
      },
      "validate": {
        "pattern": "^(0[1-9]|1[0-2])\\/\\d{2}$",
        "maxLength": 255
      }
    },
    {
      "label": "Cardholder Name",
      "type": "textfield",
      "id": "CardholderNameField",
      "key": "cardholderName",
      "layout": {
        "row": "row_18",
        "col": 8
      },
      "validate": {
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      }
    },
    {
      "label": "Check Number",
      "type": "textfield",
      "id": "CheckNumberField",
      "key": "checkNumber",
      "layout": {
        "row": "row_18",
        "col": 8
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "text": "### Fulfillment Details",
      "type": "text",
      "id": "FulfillmentHeading",
      "layout": {
        "row": "row_19",
        "col": 16
      }
    },
    {
      "label": "Delivery Method",
      "values": [
        {
          "label": "Customer Pickup",
          "value": "pickup"
        },
        {
          "label": "Site Delivery",
          "value": "delivery"
        }
      ],
      "type": "radio",
      "id": "DeliveryMethodField",
      "key": "deliveryMethod",
      "layout": {
        "row": "row_20",
        "col": 16
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "RequestedDeliveryDateField",
      "key": "requestedDeliveryDate",
      "dateLabel": "Requested Delivery Date",
      "layout": {
        "row": "row_21",
        "col": 16
      }
    },
    {
      "label": "Special Instructions",
      "type": "textarea",
      "id": "SpecialInstructionsField",
      "key": "specialInstructions",
      "layout": {
        "row": "row_22",
        "col": 16
      }
    },
    {
      "text": "### Authorization",
      "type": "text",
      "id": "AuthHeading",
      "layout": {
        "row": "row_23",
        "col": 16
      }
    },
    {
      "label": "Customer Signature (Type Full Name)",
      "type": "textfield",
      "id": "CustomerSignatureField",
      "key": "customerSignature",
      "validate": {
        "required": true,
        "minLength": 2,
        "maxLength": 100
      },
      "layout": {
        "row": "row_24",
        "col": 16
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "SignatureDateField",
      "key": "dateOfSignature",
      "dateLabel": "Date of Signature",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_25",
        "col": 16
      }
    }
  ],
  "generated": true,
  "type": "default"
