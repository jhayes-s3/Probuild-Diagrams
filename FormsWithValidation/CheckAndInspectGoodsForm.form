{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "35a6d3d"
  },
  "schemaVersion": 19,
  "id": "check-inpect-goods",
  "components": [
    {
      "text": "### Inspection Details",
      "type": "text",
      "id": "Heading_inspection_details",
      "layout": {
        "row": "Row-1",
        "col": 16
      }
    },
    {
      "label": "Inspection ID",
      "type": "textfield",
      "id": "Textfield_inspection_id",
      "key": "inspectionId",
      "validate": {
        "required": true,
        "minLength": 1,
        "maxLength": 50,
        "pattern": "^[A-Za-z0-9\\-]+$"
      },
      "layout": {
        "row": "Row-2",
        "col": 8
      }
    },
    {
      "label": "Inspector Name",
      "type": "textfield",
      "id": "Textfield_inspector_name",
      "key": "inspectorName",
      "validate": {
        "required": true,
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      },
      "layout": {
        "row": "Row-2",
        "col": 8
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Date_inspection",
      "key": "inspectionDate",
      "dateLabel": "Date of Inspection",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row-3",
        "col": 8
      }
    },
    {
      "subtype": "time",
      "type": "datetime",
      "id": "Time_inspection",
      "key": "inspectionTime",
      "timeLabel": "Time of Inspection",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row-4",
        "col": 8
      },
      "timeInterval": 15
    },
    {
      "text": "### Shipment Information",
      "type": "text",
      "id": "Heading_shipment_info",
      "layout": {
        "row": "Row-5",
        "col": 16
      }
    },
    {
      "label": "Shipment ID / Purchase Order Number",
      "type": "textfield",
      "id": "Textfield_shipment_id",
      "key": "shipmentId",
      "validate": {
        "required": true,
        "minLength": 1,
        "maxLength": 50,
        "pattern": "^[A-Za-z0-9\\-]+$"
      },
      "layout": {
        "row": "Row-6",
        "col": 8
      }
    },
    {
      "label": "Supplier/Vendor Name",
      "type": "textfield",
      "id": "Textfield_supplier_name",
      "key": "supplierName",
      "validate": {
        "required": true,
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      },
      "layout": {
        "row": "Row-6",
        "col": 8
      }
    },
    {
      "label": "Carrier Name",
      "type": "textfield",
      "id": "Textfield_carrier_name",
      "key": "carrierName",
      "layout": {
        "row": "Row-7",
        "col": 8
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "Vehicle License Plate",
      "type": "textfield",
      "id": "Textfield_license_plate",
      "key": "vehicleLicensePlate",
      "layout": {
        "row": "Row-7",
        "col": 8
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Date_arrival",
      "key": "arrivalDate",
      "dateLabel": "Date of Arrival",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row-8",
        "col": 8
      }
    },
    {
      "subtype": "time",
      "type": "datetime",
      "id": "Time_arrival",
      "key": "arrivalTime",
      "timeLabel": "Time of Arrival",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row-9",
        "col": 8
      },
      "timeInterval": 15
    },
    {
      "text": "### Goods Verification",
      "type": "text",
      "id": "Heading_goods_verification",
      "layout": {
        "row": "Row-10",
        "col": 16
      }
    },
    {
      "text": "Enter details for each item type received. This section would typically be a repeatable list.",
      "type": "text",
      "id": "Paragraph_goods_verification",
      "layout": {
        "row": "Row-11",
        "col": 16
      }
    },
    {
      "label": "Product Code / SKU",
      "type": "textfield",
      "id": "Textfield_product_code",
      "key": "productCode",
      "layout": {
        "row": "Row-12",
        "col": 8
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "Product Description",
      "type": "textfield",
      "id": "Textfield_product_description",
      "key": "productDescription",
      "layout": {
        "row": "Row-12",
        "col": 8
      }
    },
    {
      "label": "Expected Quantity",
      "type": "number",
      "id": "Number_expected_qty",
      "key": "expectedQuantity",
      "layout": {
        "row": "Row-13",
        "col": 5
      },
      "validate": {
        "min": 0
      }
    },
    {
      "label": "Received Quantity",
      "type": "number",
      "id": "Number_received_qty",
      "key": "receivedQuantity",
      "layout": {
        "row": "Row-13",
        "col": 5
      },
      "validate": {
        "min": 0
      }
    },
    {
      "label": "Quantity Discrepancy (+/-)",
      "type": "number",
      "id": "Number_discrepancy_qty",
      "key": "quantityDiscrepancy",
      "layout": {
        "row": "Row-13",
        "col": 6
      },
      "validate": {
        "min": 0
      }
    },
    {
      "label": "Unit of Measure",
      "values": [
        {
          "label": "Pallet",
          "value": "pallet"
        },
        {
          "label": "Box",
          "value": "box"
        },
        {
          "label": "Unit",
          "value": "unit"
        }
      ],
      "type": "select",
      "id": "Select_uom",
      "key": "unitOfMeasure",
      "layout": {
        "row": "Row-14",
        "col": 8
      }
    },
    {
      "label": "Batch / Lot Number",
      "type": "textfield",
      "id": "Textfield_batch_lot",
      "key": "batchLotNumber",
      "layout": {
        "row": "Row-14",
        "col": 8
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Date_expiration",
      "key": "expirationDate",
      "dateLabel": "Expiration Date (if applicable)",
      "layout": {
        "row": "Row-15",
        "col": 8
      }
    },
    {
      "text": "### Packaging Inspection Checklist",
      "type": "text",
      "id": "Heading_packaging_checklist",
      "layout": {
        "row": "Row-16",
        "col": 16
      }
    },
    {
      "label": "Exterior Packaging Condition",
      "values": [
        {
          "label": "Good",
          "value": "good"
        },
        {
          "label": "Damaged",
          "value": "damaged"
        },
        {
          "label": "Wet",
          "value": "wet"
        }
      ],
      "type": "select",
      "id": "Select_packaging_condition",
      "key": "exteriorPackagingCondition",
      "layout": {
        "row": "Row-17",
        "col": 8
      }
    },
    {
      "label": "Pallet Condition",
      "values": [
        {
          "label": "Good",
          "value": "good"
        },
        {
          "label": "Damaged",
          "value": "damaged"
        }
      ],
      "type": "select",
      "id": "Select_pallet_condition",
      "key": "palletCondition",
      "layout": {
        "row": "Row-17",
        "col": 8
      }
    },
    {
      "label": "Seals Intact",
      "values": [
        {
          "label": "Yes",
          "value": "yes"
        },
        {
          "label": "No",
          "value": "no"
        }
      ],
      "type": "radio",
      "id": "Radio_seals_intact",
      "key": "sealsIntact",
      "layout": {
        "row": "Row-18",
        "col": 8
      }
    },
    {
      "label": "Correct Labeling",
      "values": [
        {
          "label": "Yes",
          "value": "yes"
        },
        {
          "label": "No",
          "value": "no"
        }
      ],
      "type": "radio",
      "id": "Radio_correct_labeling",
      "key": "correctLabeling",
      "layout": {
        "row": "Row-19",
        "col": 8
      }
    },
    {
      "text": "### Quality Inspection Checklist",
      "type": "text",
      "id": "Heading_quality_checklist",
      "layout": {
        "row": "Row-20",
        "col": 16
      }
    },
    {
      "text": "For a sample of items.",
      "type": "text",
      "id": "Paragraph_quality_checklist",
      "layout": {
        "row": "Row-21",
        "col": 16
      }
    },
    {
      "label": "Product Matches Specifications",
      "values": [
        {
          "label": "Yes",
          "value": "yes"
        },
        {
          "label": "No",
          "value": "no"
        }
      ],
      "type": "radio",
      "id": "Radio_matches_specs",
      "key": "productMatchesSpecifications",
      "layout": {
        "row": "Row-22",
        "col": 8
      }
    },
    {
      "label": "Visible Defects (scratches, dents, discoloration)",
      "values": [
        {
          "label": "Yes",
          "value": "yes"
        },
        {
          "label": "No",
          "value": "no"
        }
      ],
      "type": "radio",
      "id": "Radio_visible_defects",
      "key": "visibleDefects",
      "layout": {
        "row": "Row-23",
        "col": 8
      }
    },
    {
      "label": "Correct Dimensions/Weight",
      "values": [
        {
          "label": "Pass",
          "value": "pass"
        },
        {
          "label": "Fail",
          "value": "fail"
        },
        {
          "label": "N/A",
          "value": "na"
        }
      ],
      "type": "select",
      "id": "Select_dimensions_weight",
      "key": "correctDimensionsWeight",
      "layout": {
        "row": "Row-24",
        "col": 8
      }
    },
    {
      "label": "Temperature Check (if applicable)",
      "type": "number",
      "id": "Number_temperature",
      "key": "temperatureCheck",
      "description": "Enter temperature in Celsius.",
      "appearance": {
        "suffixAdorner": "\u00b0C"
      },
      "layout": {
        "row": "Row-24",
        "col": 8
      }
    },
    {
      "text": "### Inspection Outcome",
      "type": "text",
      "id": "Heading_inspection_outcome",
      "layout": {
        "row": "Row-25",
        "col": 16
      }
    },
    {
      "label": "Overall Status",
      "values": [
        {
          "label": "Accepted",
          "value": "accepted"
        },
        {
          "label": "Partially Accepted",
          "value": "partially_accepted"
        },
        {
          "label": "Rejected",
          "value": "rejected"
        }
      ],
      "type": "select",
      "id": "Select_overall_status",
      "key": "overallStatus",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row-26",
        "col": 8
      }
    },
    {
      "label": "Action Taken",
      "values": [
        {
          "label": "Quarantine",
          "value": "quarantine"
        },
        {
          "label": "Return to Vendor",
          "value": "return_to_vendor"
        },
        {
          "label": "Accept with Note",
          "value": "accept_with_note"
        }
      ],
      "type": "select",
      "id": "Select_action_taken",
      "key": "actionTaken",
      "layout": {
        "row": "Row-26",
        "col": 8
      }
    },
    {
      "label": "Reason for Partial Acceptance or Rejection",
      "type": "textarea",
      "id": "Textarea_rejection_reason",
      "key": "rejectionReason",
      "layout": {
        "row": "Row-27",
        "col": 16
      }
    },
    {
      "label": "Detailed Comments/Notes",
      "type": "textarea",
      "id": "Textarea_comments",
      "key": "detailedComments",
      "layout": {
        "row": "Row-28",
        "col": 16
      }
    },
    {
      "text": "### Attachments",
      "type": "text",
      "id": "Heading_attachments",
      "layout": {
        "row": "Row-29",
        "col": 16
      }
    },
    {
      "label": "Photo of Damaged Goods",
      "type": "textfield",
      "id": "Textfield_photo_damage",
      "key": "photoDamagedGoods",
      "description": "A file upload component would be used here.",
      "layout": {
        "row": "Row-30",
        "col": 16
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "Photo of Packing Slip / Bill of Lading",
      "type": "textfield",
      "id": "Textfield_photo_packing_slip",
      "key": "photoPackingSlip",
      "description": "A file upload component would be used here.",
      "layout": {
        "row": "Row-31",
        "col": 16
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "text": "### Signatures",
      "type": "text",
      "id": "Heading_signatures",
      "layout": {
        "row": "Row-32",
        "col": 16
      }
    },
    {
      "label": "Warehouse Manager Signature",
      "type": "textfield",
      "id": "Textfield_warehouse_manager_sig",
      "key": "warehouseManagerSignature",
      "description": "Type full name to sign.",
      "validate": {
        "required": true,
        "minLength": 2,
        "maxLength": 100
      },
      "layout": {
        "row": "Row-33",
        "col": 8
      }
    },
    {
      "label": "Driver Signature (if present)",
      "type": "textfield",
      "id": "Textfield_driver_sig",
      "key": "driverSignature",
      "description": "Type full name to sign.",
      "layout": {
        "row": "Row-33",
        "col": 8
      },
      "validate": {
        "minLength": 2,
        "maxLength": 100
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Date_signature",
      "key": "signatureDate",
      "dateLabel": "Date of Signature",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row-34",
        "col": 8
      }
    }
  ],
  "generated": true,
  "type": "default"
}