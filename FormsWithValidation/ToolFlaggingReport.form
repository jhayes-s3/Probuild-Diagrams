{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "35a6d3d"
  },
  "schemaVersion": 19,
  "id": "flag-and-log-tools-in-maintenance-tracking-system-form",
  "components": [
    {
      "text": "### Tool Flagging Report",
      "type": "text",
      "id": "Form-heading-main",
      "layout": {
        "row": "row-0",
        "col": 16
      }
    },
    {
      "text": "### Tool Identification",
      "type": "text",
      "id": "Heading-tool-id",
      "layout": {
        "row": "row-1",
        "col": 16
      }
    },
    {
      "label": "Tool ID / Asset Number",
      "type": "textfield",
      "id": "Field-tool-id",
      "key": "toolId",
      "validate": {
        "required": true,
        "maxLength": 60,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-_/# ]{1,59}$",
        "minLength": 2
      },
      "layout": {
        "row": "row-2",
        "col": 8
      }
    },
    {
      "label": "Tool Name / Description",
      "type": "textfield",
      "id": "Field-tool-name",
      "key": "toolName",
      "validate": {
        "required": true,
        "maxLength": 255,
        "minLength": 2
      },
      "layout": {
        "row": "row-2",
        "col": 8
      }
    },
    {
      "label": "Tool Category",
      "values": [
        {
          "label": "Hand Tool",
          "value": "handTool"
        },
        {
          "label": "Power Tool",
          "value": "powerTool"
        },
        {
          "label": "Diagnostic Equipment",
          "value": "diagnostic"
        },
        {
          "label": "Safety Gear",
          "value": "safety"
        }
      ],
      "type": "select",
      "id": "Field-tool-category",
      "key": "toolCategory",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row-3",
        "col": 8
      }
    },
    {
      "label": "Current Location / Assigned Vehicle",
      "type": "textfield",
      "id": "Field-current-location",
      "key": "currentLocation",
      "layout": {
        "row": "row-3",
        "col": 8
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "text": "### Reporting Information",
      "type": "text",
      "id": "Heading-reporting-info",
      "layout": {
        "row": "row-4",
        "col": 16
      }
    },
    {
      "label": "Reported By (Employee Name / ID)",
      "type": "textfield",
      "id": "Field-reported-by",
      "key": "reportedBy",
      "validate": {
        "required": true,
        "maxLength": 60,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-_/# ]{1,59}$",
        "minLength": 2
      },
      "layout": {
        "row": "row-5",
        "col": 8
      }
    },
    {
      "subtype": "datetime",
      "type": "datetime",
      "id": "Field-report-datetime",
      "key": "reportDateTime",
      "dateLabel": "Date of Report",
      "timeLabel": "Time of Report",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row-5",
        "col": 8
      },
      "timeInterval": 15
    },
    {
      "text": "### Flag Details",
      "type": "text",
      "id": "Heading-flag-details",
      "layout": {
        "row": "row-6",
        "col": 16
      }
    },
    {
      "label": "Reason for Flag",
      "values": [
        {
          "label": "Needs Repair",
          "value": "repair"
        },
        {
          "label": "Needs Calibration",
          "value": "calibration"
        },
        {
          "label": "Damaged",
          "value": "damaged"
        },
        {
          "label": "Lost",
          "value": "lost"
        },
        {
          "label": "Out of Service",
          "value": "outOfService"
        }
      ],
      "type": "select",
      "id": "Field-reason-for-flag",
      "key": "reasonForFlag",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row-7",
        "col": 6
      }
    },
    {
      "label": "Flag Status",
      "values": [
        {
          "label": "Active",
          "value": "active"
        },
        {
          "label": "In Progress",
          "value": "inProgress"
        },
        {
          "label": "Resolved",
          "value": "resolved"
        }
      ],
      "type": "select",
      "id": "Field-flag-status",
      "key": "flagStatus",
      "defaultValue": "active",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row-7",
        "col": 5
      }
    },
    {
      "label": "Priority Level",
      "values": [
        {
          "label": "Critical",
          "value": "critical"
        },
        {
          "label": "High",
          "value": "high"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Low",
          "value": "low"
        }
      ],
      "type": "select",
      "id": "Field-priority-level",
      "key": "priorityLevel",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row-7",
        "col": 5
      }
    },
    {
      "label": "Detailed Description of Issue/Reason",
      "type": "textarea",
      "id": "Field-detailed-description",
      "key": "detailedDescription",
      "validate": {
        "required": true,
        "minLength": 10,
        "maxLength": 1000
      },
      "layout": {
        "row": "row-8",
        "col": 16
      }
    },
    {
      "text": "### Supporting Evidence",
      "type": "text",
      "id": "Heading-supporting-evidence",
      "layout": {
        "row": "row-9",
        "col": 16
      }
    },
    {
      "text": "Please upload photos or videos of the issue in the next step of the process.",
      "type": "text",
      "id": "Paragraph-upload-info",
      "layout": {
        "row": "row-10",
        "col": 16
      }
    },
    {
      "text": "### Maintenance Log (Optional)",
      "type": "text",
      "id": "Heading-maintenance-log",
      "layout": {
        "row": "row-11",
        "col": 16
      }
    },
    {
      "label": "Action Taken",
      "type": "textarea",
      "id": "Field-action-taken",
      "key": "actionTaken",
      "layout": {
        "row": "row-12",
        "col": 16
      },
      "validate": {
        "maxLength": 1000
      }
    },
    {
      "label": "Notes / Comments",
      "type": "textarea",
      "id": "Field-notes-comments",
      "key": "maintenanceNotes",
      "layout": {
        "row": "row-13",
        "col": 16
      },
      "validate": {
        "maxLength": 1000
      }
    },
    {
      "label": "Technician Assigned",
      "type": "textfield",
      "id": "Field-technician-assigned",
      "key": "technicianAssigned",
      "layout": {
        "row": "row-14",
        "col": 8
      },
      "validate": {
        "maxLength": 255,
        "pattern": "^[A-Za-z][A-Za-z\\s\\-']{1,99}$"
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Field-date-of-action",
      "key": "dateOfAction",
      "dateLabel": "Date of Action",
      "layout": {
        "row": "row-14",
        "col": 8
      }
    },
    {
      "label": "Resolution Details",
      "type": "textarea",
      "id": "Field-resolution-details",
      "key": "resolutionDetails",
      "layout": {
        "row": "row-15",
        "col": 16
      },
      "validate": {
        "maxLength": 1000
      }
    },
    {
      "label": "Submit Report",
      "action": "submit",
      "type": "button",
      "id": "Button-submit",
      "layout": {
        "row": "row-16",
        "col": 16
      }
    }
  ],
  "generated": true,
  "type": "default"
}