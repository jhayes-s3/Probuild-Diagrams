{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "35a6d3d"
  },
  "schemaVersion": 19,
  "id": "fill-in-loan-information-form",
  "components": [
    {
      "text": "### Loan Application Form",
      "id": "FormHeading",
      "type": "text",
      "layout": {
        "row": "row_0",
        "col": 16
      }
    },
    {
      "text": "### Personal Information",
      "id": "PersonalInfoHeading",
      "type": "text",
      "layout": {
        "row": "row_1",
        "col": 16
      }
    },
    {
      "label": "Full Legal Name",
      "id": "FullNameField",
      "type": "textfield",
      "key": "fullName",
      "layout": {
        "row": "row_2",
        "col": 16
      },
      "validate": {
        "required": true,
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      }
    },
    {
      "subtype": "date",
      "id": "DobField",
      "type": "datetime",
      "key": "dateOfBirth",
      "dateLabel": "Date of Birth",
      "layout": {
        "row": "row_3",
        "col": 16
      },
      "validate": {
        "required": true,
        "before": "today"
      }
    },
    {
      "label": "SSN or ITIN",
      "id": "SsnField",
      "type": "textfield",
      "key": "ssnOrItin",
      "description": "Social Security Number or Individual Taxpayer Identification Number",
      "layout": {
        "row": "row_4",
        "col": 8
      },
      "validate": {
        "required": true,
        "minLength": 9,
        "maxLength": 11,
        "pattern": "^\\d{3}-\\d{2}-\\d{4}$|^\\d{9}$"
      }
    },
    {
      "label": "Email Address",
      "id": "EmailField",
      "type": "textfield",
      "key": "emailAddress",
      "layout": {
        "row": "row_5",
        "col": 8
      },
      "validate": {
        "required": true,
        "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
      }
    },
    {
      "label": "Mobile Phone Number",
      "id": "PhoneField",
      "type": "textfield",
      "key": "mobilePhoneNumber",
      "layout": {
        "row": "row_5",
        "col": 8
      },
      "validate": {
        "required": true,
        "pattern": "^[\\+]?[\\d\\s\\-\\(\\)]{7,15}$",
        "maxLength": 255
      }
    },
    {
      "label": "Current Residential Address",
      "id": "AddressField",
      "type": "textarea",
      "key": "currentAddress",
      "layout": {
        "row": "row_6",
        "col": 16
      },
      "validate": {
        "required": true
      }
    },
    {
      "text": "### Income & Employment Information",
      "id": "IncomeEmploymentHeading",
      "type": "text",
      "layout": {
        "row": "row_7",
        "col": 16
      }
    },
    {
      "label": "Employment Status",
      "values": [
        {
          "label": "Employed",
          "value": "employed"
        },
        {
          "label": "Self-Employed",
          "value": "selfEmployed"
        },
        {
          "label": "Unemployed",
          "value": "unemployed"
        },
        {
          "label": "Retired",
          "value": "retired"
        },
        {
          "label": "Student",
          "value": "student"
        }
      ],
      "id": "EmploymentStatusField",
      "type": "select",
      "key": "employmentStatus",
      "layout": {
        "row": "row_8",
        "col": 16
      },
      "validate": {
        "required": true
      }
    },
    {
      "label": "Employer Name (if applicable)",
      "id": "EmployerNameField",
      "type": "textfield",
      "key": "employerName",
      "layout": {
        "row": "row_9",
        "col": 8
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "Job Title",
      "id": "JobTitleField",
      "type": "textfield",
      "key": "jobTitle",
      "layout": {
        "row": "row_9",
        "col": 8
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "Total Annual Income",
      "id": "AnnualIncomeField",
      "type": "number",
      "key": "annualIncome",
      "layout": {
        "row": "row_10",
        "col": 8
      },
      "appearance": {
        "prefixAdorner": "$"
      },
      "validate": {
        "required": true,
        "min": 0
      }
    },
    {
      "label": "Source of Income",
      "id": "IncomeSourceField",
      "type": "textfield",
      "key": "sourceOfIncome",
      "layout": {
        "row": "row_10",
        "col": 8
      },
      "validate": {
        "required": true,
        "maxLength": 255
      }
    },
    {
      "text": "### Loan Details",
      "id": "LoanDetailsHeading",
      "type": "text",
      "layout": {
        "row": "row_11",
        "col": 16
      }
    },
    {
      "label": "Loan Amount",
      "id": "LoanAmountField",
      "type": "number",
      "key": "loanAmount",
      "description": "Often pre-filled from checkout total",
      "layout": {
        "row": "row_12",
        "col": 8
      },
      "appearance": {
        "prefixAdorner": "$"
      },
      "validate": {
        "required": true,
        "min": 0
      }
    },
    {
      "label": "Loan Term Preference",
      "values": [
        {
          "label": "6 Months",
          "value": "6"
        },
        {
          "label": "12 Months",
          "value": "12"
        },
        {
          "label": "24 Months",
          "value": "24"
        },
        {
          "label": "36 Months",
          "value": "36"
        }
      ],
      "id": "LoanTermField",
      "type": "select",
      "key": "loanTerm",
      "layout": {
        "row": "row_12",
        "col": 8
      },
      "validate": {
        "required": true
      }
    },
    {
      "text": "### Agreements & Consent",
      "id": "AgreementsHeading",
      "type": "text",
      "layout": {
        "row": "row_13",
        "col": 16
      }
    },
    {
      "label": "I consent to a credit check (soft or hard pull).",
      "id": "CreditCheckField",
      "type": "checkbox",
      "key": "consentCreditCheck",
      "layout": {
        "row": "row_14",
        "col": 16
      },
      "validate": {
        "required": true
      }
    },
    {
      "label": "I agree to the Loan Terms and Conditions.",
      "id": "TermsAgreementField",
      "type": "checkbox",
      "key": "agreeToTerms",
      "layout": {
        "row": "row_15",
        "col": 16
      },
      "validate": {
        "required": true
      }
    },
    {
      "label": "I consent to the E-Sign agreement.",
      "id": "EsignConsentField",
      "type": "checkbox",
      "key": "eSignConsent",
      "layout": {
        "row": "row_16",
        "col": 16
      },
      "validate": {
        "required": true
      }
    },
    {
      "label": "I acknowledge the Privacy Policy.",
      "id": "PrivacyPolicyField",
      "type": "checkbox",
      "key": "privacyPolicyAck",
      "layout": {
        "row": "row_17",
        "col": 16
      },
      "validate": {
        "required": true
      }
    },
    {
      "text": "### Signature",
      "id": "SignatureHeading",
      "type": "text",
      "layout": {
        "row": "row_18",
        "col": 16
      }
    },
    {
      "label": "Digital Signature",
      "id": "DigitalSignatureField",
      "type": "textfield",
      "key": "digitalSignature",
      "description": "Please type your full legal name to sign.",
      "layout": {
        "row": "row_19",
        "col": 10
      },
      "validate": {
        "required": true,
        "minLength": 2,
        "maxLength": 100
      }
    },
    {
      "subtype": "date",
      "id": "ApplicationDateField",
      "type": "datetime",
      "key": "applicationDate",
      "dateLabel": "Date of Application",
      "layout": {
        "row": "row_19",
        "col": 6
      },
      "validate": {
        "required": true
      }
    },
    {
      "label": "Submit Application",
      "action": "submit",
      "id": "SubmitButton",
      "type": "button",
      "layout": {
        "row": "row_20",
        "col": 16
      }
    }
  ],
  "generated": true,
  "type": "default"
}