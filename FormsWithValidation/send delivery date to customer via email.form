{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "35a6d3d"
  },
  "schemaVersion": 19,
  "id": "send-delivery-date-to-customer-via-email-form",
  "components": [
    {
      "text": "### Customer & Order Details",
      "type": "text",
      "id": "Heading_customer_order",
      "layout": {
        "row": "Row_1",
        "col": 16
      }
    },
    {
      "label": "Customer's Full Name",
      "type": "textfield",
      "id": "Field_customerFullName",
      "key": "customerFullName",
      "validate": {
        "required": true,
        "maxLength": 255,
        "pattern": "^[A-Za-z][A-Za-z\\s\\-']{1,99}$",
        "minLength": 2
      },
      "layout": {
        "row": "Row_2",
        "col": 8
      }
    },
    {
      "label": "Customer's Email Address",
      "type": "textfield",
      "id": "Field_customerEmail",
      "key": "customerEmail",
      "validate": {
        "required": true,
        "maxLength": 255,
        "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
      },
      "layout": {
        "row": "Row_2",
        "col": 8
      }
    },
    {
      "label": "Order ID / Reference Number",
      "type": "textfield",
      "id": "Field_orderId",
      "key": "orderId",
      "validate": {
        "required": true,
        "maxLength": 60,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-_/# ]{1,59}$",
        "minLength": 2
      },
      "layout": {
        "row": "Row_3",
        "col": 16
      }
    },
    {
      "text": "### Shipping Information",
      "type": "text",
      "id": "Heading_shipping",
      "layout": {
        "row": "Row_4",
        "col": 16
      }
    },
    {
      "label": "Carrier Name",
      "type": "textfield",
      "id": "Field_carrierName",
      "key": "carrierName",
      "validate": {
        "required": true,
        "maxLength": 255,
        "minLength": 2
      },
      "layout": {
        "row": "Row_5",
        "col": 8
      }
    },
    {
      "label": "Tracking Number",
      "type": "textfield",
      "id": "Field_trackingNumber",
      "key": "trackingNumber",
      "validate": {
        "required": true,
        "maxLength": 60,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-_/# ]{1,59}$",
        "minLength": 2
      },
      "layout": {
        "row": "Row_5",
        "col": 8
      }
    },
    {
      "label": "Tracking URL",
      "type": "textfield",
      "id": "Field_trackingUrl",
      "key": "trackingUrl",
      "description": "Provide the full URL for the tracking page.",
      "layout": {
        "row": "Row_6",
        "col": 16
      },
      "validate": {
        "maxLength": 500,
        "pattern": "^https?://.+"
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Field_estimatedDeliveryDate",
      "key": "estimatedDeliveryDate",
      "dateLabel": "Estimated Delivery Date",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_7",
        "col": 16
      }
    },
    {
      "text": "### Email Notification Details",
      "type": "text",
      "id": "Heading_email",
      "layout": {
        "row": "Row_8",
        "col": 16
      }
    },
    {
      "label": "Sender Email Address (\"From\")",
      "type": "textfield",
      "id": "Field_senderEmail",
      "key": "senderEmail",
      "validate": {
        "required": true,
        "maxLength": 255,
        "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
      },
      "layout": {
        "row": "Row_9",
        "col": 8
      }
    },
    {
      "label": "Email Subject Line",
      "type": "textfield",
      "id": "Field_emailSubject",
      "key": "emailSubject",
      "validate": {
        "required": true,
        "maxLength": 255,
        "minLength": 2
      },
      "layout": {
        "row": "Row_9",
        "col": 8
      }
    },
    {
      "label": "Email Body Content/Template",
      "type": "textarea",
      "id": "Field_emailBody",
      "key": "emailBody",
      "description": "Enter the email content. You can use variables like {{customerName}} or {{trackingNumber}}.",
      "validate": {
        "required": true,
        "maxLength": 1000,
        "minLength": 10
      },
      "layout": {
        "row": "Row_10",
        "col": 16
      }
    }
  ],
  "generated": true,
  "type": "default"
}