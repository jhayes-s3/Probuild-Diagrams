{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "35a6d3d"
  },
  "schemaVersion": 19,
  "id": "issue-tool-to-customer-with-return-date-form",
  "components": [
    {
      "text": "### Tool Checkout & Return Form",
      "type": "text",
      "id": "Form-heading",
      "layout": {
        "row": "row-0",
        "col": 16
      }
    },
    {
      "text": "##### Customer Information",
      "type": "text",
      "id": "Customer-info-heading",
      "layout": {
        "row": "row-1",
        "col": 16
      }
    },
    {
      "label": "Customer Name",
      "type": "textfield",
      "id": "Customer-name-field",
      "key": "customerName",
      "validate": {
        "required": true,
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      },
      "layout": {
        "row": "row-2",
        "col": 8
      }
    },
    {
      "label": "Customer ID / Account Number",
      "type": "textfield",
      "id": "Customer-id-field",
      "key": "customerId",
      "validate": {
        "required": true,
        "minLength": 1,
        "maxLength": 50,
        "pattern": "^[A-Za-z0-9\\-]+$"
      },
      "layout": {
        "row": "row-2",
        "col": 8
      }
    },
    {
      "label": "Contact Phone Number",
      "type": "textfield",
      "id": "Contact-phone-field",
      "key": "contactPhone",
      "validate": {
        "required": true,
        "pattern": "^[\\+]?[\\d\\s\\-\\(\\)]{7,15}$",
        "maxLength": 255
      },
      "layout": {
        "row": "row-3",
        "col": 8
      }
    },
    {
      "label": "Contact Email Address",
      "type": "textfield",
      "id": "Contact-email-field",
      "key": "contactEmail",
      "validate": {
        "required": true,
        "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
        "maxLength": 255
      },
      "layout": {
        "row": "row-3",
        "col": 8
      }
    },
    {
      "text": "##### Tool Information",
      "type": "text",
      "id": "Tool-info-heading",
      "layout": {
        "row": "row-4",
        "col": 16
      }
    },
    {
      "label": "Tool Name",
      "type": "textfield",
      "id": "Tool-name-field",
      "key": "toolName",
      "validate": {
        "required": true,
        "maxLength": 255
      },
      "layout": {
        "row": "row-5",
        "col": 6
      }
    },
    {
      "label": "Tool ID / Serial Number",
      "type": "textfield",
      "id": "Tool-id-field",
      "key": "toolId",
      "validate": {
        "required": true,
        "minLength": 1,
        "maxLength": 50,
        "pattern": "^[A-Za-z0-9\\-]+$"
      },
      "layout": {
        "row": "row-5",
        "col": 5
      }
    },
    {
      "label": "Asset Tag",
      "type": "textfield",
      "id": "Asset-tag-field",
      "key": "assetTag",
      "layout": {
        "row": "row-5",
        "col": 5
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "Condition at Checkout",
      "values": [
        {
          "label": "New",
          "value": "new"
        },
        {
          "label": "Good",
          "value": "good"
        },
        {
          "label": "Fair",
          "value": "fair"
        },
        {
          "label": "Damaged",
          "value": "damaged"
        }
      ],
      "type": "select",
      "id": "Condition-checkout-field",
      "key": "conditionAtCheckout",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row-6",
        "col": 16
      }
    },
    {
      "label": "Checkout Notes",
      "type": "textarea",
      "id": "Checkout-notes-field",
      "key": "checkoutNotes",
      "layout": {
        "row": "row-7",
        "col": 16
      }
    },
    {
      "text": "##### Transaction Details",
      "type": "text",
      "id": "Transaction-details-heading",
      "layout": {
        "row": "row-8",
        "col": 16
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Issue-date-field",
      "key": "issueDate",
      "dateLabel": "Issue Date",
      "validate": {
        "required": true,
        "after": "yesterday"
      },
      "layout": {
        "row": "row-9",
        "col": 8
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Return-date-field",
      "key": "expectedReturnDate",
      "dateLabel": "Expected Return Date",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row-9",
        "col": 8
      }
    },
    {
      "label": "Issued By (Employee Name/ID)",
      "type": "textfield",
      "id": "Issued-by-field",
      "key": "issuedBy",
      "validate": {
        "required": true,
        "maxLength": 255
      },
      "layout": {
        "row": "row-10",
        "col": 16
      }
    },
    {
      "label": "Deposit Collected",
      "type": "number",
      "id": "Deposit-collected-field",
      "key": "depositCollected",
      "appearance": {
        "prefixAdorner": "$"
      },
      "layout": {
        "row": "row-11",
        "col": 8
      },
      "validate": {
        "min": 0
      }
    },
    {
      "label": "Rental Fee (if applicable)",
      "type": "number",
      "id": "Rental-fee-field",
      "key": "rentalFee",
      "appearance": {
        "prefixAdorner": "$"
      },
      "layout": {
        "row": "row-11",
        "col": 8
      },
      "validate": {
        "min": 0
      }
    },
    {
      "text": "##### Return Details (to be filled upon return)",
      "type": "text",
      "id": "Return-details-heading",
      "layout": {
        "row": "row-12",
        "col": 16
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Actual-return-date-field",
      "key": "actualReturnDate",
      "dateLabel": "Actual Return Date",
      "layout": {
        "row": "row-13",
        "col": 8
      }
    },
    {
      "label": "Condition at Return",
      "values": [
        {
          "label": "New",
          "value": "new"
        },
        {
          "label": "Good",
          "value": "good"
        },
        {
          "label": "Fair",
          "value": "fair"
        },
        {
          "label": "Damaged",
          "value": "damaged"
        }
      ],
      "type": "select",
      "id": "Condition-return-field",
      "key": "conditionAtReturn",
      "layout": {
        "row": "row-13",
        "col": 8
      }
    },
    {
      "label": "Received By (Employee Name/ID)",
      "type": "textfield",
      "id": "Received-by-field",
      "key": "receivedBy",
      "layout": {
        "row": "row-14",
        "col": 16
      },
      "validate": {
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      }
    },
    {
      "label": "Return Notes (e.g., damage description, late fees)",
      "type": "textarea",
      "id": "Return-notes-field",
      "key": "returnNotes",
      "layout": {
        "row": "row-15",
        "col": 16
      }
    },
    {
      "text": "##### Agreement",
      "type": "text",
      "id": "Agreement-heading",
      "layout": {
        "row": "row-16",
        "col": 16
      }
    },
    {
      "label": "Customer Signature (Type Full Name)",
      "type": "textfield",
      "id": "Customer-signature-field",
      "key": "customerSignature",
      "validate": {
        "required": true,
        "minLength": 2,
        "maxLength": 100
      },
      "layout": {
        "row": "row-17",
        "col": 8
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Date-signed-field",
      "key": "dateSigned",
      "dateLabel": "Date Signed",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row-17",
        "col": 8
      }
    }
  ],
  "generated": true,
  "type": "default"
}