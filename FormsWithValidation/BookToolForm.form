{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "35a6d3d"
  },
  "schemaVersion": 19,
  "id": "book-item",
  "components": [
    {
      "text": "### Customer Details",
      "type": "text",
      "id": "Heading_Customer",
      "layout": {
        "row": "Row_1",
        "col": 16
      }
    },
    {
      "label": "Full Name",
      "type": "textfield",
      "id": "Field_1",
      "key": "fullName",
      "validate": {
        "required": true,
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      },
      "layout": {
        "row": "Row_2",
        "col": 8
      }
    },
    {
      "label": "Customer ID",
      "type": "textfield",
      "id": "Field_2",
      "key": "customerId",
      "description": "If you are an existing customer.",
      "layout": {
        "row": "Row_2",
        "col": 8
      },
      "validate": {
        "minLength": 1,
        "maxLength": 50,
        "pattern": "^[A-Za-z0-9\\-]+$"
      }
    },
    {
      "label": "Company Name (if applicable)",
      "type": "textfield",
      "id": "Field_3",
      "key": "companyName",
      "layout": {
        "row": "Row_3",
        "col": 16
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "Phone Number",
      "type": "textfield",
      "id": "Field_4",
      "key": "phoneNumber",
      "validate": {
        "required": true,
        "pattern": "^[\\+]?[\\d\\s\\-\\(\\)]{7,15}$",
        "maxLength": 255
      },
      "layout": {
        "row": "Row_4",
        "col": 8
      }
    },
    {
      "label": "Email Address",
      "type": "textfield",
      "id": "Field_5",
      "key": "emailAddress",
      "validate": {
        "required": true,
        "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
      },
      "layout": {
        "row": "Row_4",
        "col": 8
      }
    },
    {
      "label": "Billing Address",
      "type": "textarea",
      "id": "Field_6",
      "key": "billingAddress",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_5",
        "col": 16
      }
    },
    {
      "label": "Shipping/Delivery Address (if different)",
      "type": "textarea",
      "id": "Field_7",
      "key": "shippingAddress",
      "layout": {
        "row": "Row_6",
        "col": 16
      }
    },
    {
      "text": "### Booking Details",
      "type": "text",
      "id": "Heading_Booking",
      "layout": {
        "row": "Row_7",
        "col": 16
      }
    },
    {
      "label": "Booking ID",
      "type": "textfield",
      "id": "Field_8",
      "key": "bookingId",
      "layout": {
        "row": "Row_8",
        "col": 16
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "subtype": "datetime",
      "type": "datetime",
      "id": "Field_9",
      "key": "rentalStart",
      "dateLabel": "Rental Start Date",
      "timeLabel": "Start Time",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_9",
        "col": 8
      },
      "timeInterval": 15
    },
    {
      "subtype": "datetime",
      "type": "datetime",
      "id": "Field_10",
      "key": "rentalEnd",
      "dateLabel": "Rental End Date",
      "timeLabel": "End Time",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_9",
        "col": 8
      },
      "timeInterval": 15
    },
    {
      "label": "Pickup or Delivery Option",
      "values": [
        {
          "label": "Pickup",
          "value": "pickup"
        },
        {
          "label": "Delivery",
          "value": "delivery"
        }
      ],
      "type": "radio",
      "id": "Field_11",
      "key": "deliveryOption",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_10",
        "col": 16
      }
    },
    {
      "label": "Pickup Location",
      "values": [
        {
          "label": "Warehouse A - North",
          "value": "WH-A"
        },
        {
          "label": "Warehouse B - South",
          "value": "WH-B"
        },
        {
          "label": "Downtown Store",
          "value": "DT"
        }
      ],
      "type": "select",
      "id": "Field_12",
      "key": "pickupLocation",
      "layout": {
        "row": "Row_11",
        "col": 16
      }
    },
    {
      "label": "Delivery Instructions",
      "type": "textarea",
      "id": "Field_13",
      "key": "deliveryInstructions",
      "layout": {
        "row": "Row_12",
        "col": 16
      }
    },
    {
      "text": "### Tool Selection",
      "type": "text",
      "id": "Heading_Tool",
      "layout": {
        "row": "Row_13",
        "col": 16
      }
    },
    {
      "label": "Tool Name / SKU",
      "type": "textfield",
      "id": "Field_14",
      "key": "toolNameSku",
      "validate": {
        "required": true,
        "minLength": 1,
        "maxLength": 50,
        "pattern": "^[A-Za-z0-9\\-]+$"
      },
      "layout": {
        "row": "Row_14",
        "col": 6
      }
    },
    {
      "label": "Tool Category",
      "values": [
        {
          "label": "Power Tools",
          "value": "power"
        },
        {
          "label": "Hand Tools",
          "value": "hand"
        },
        {
          "label": "Gardening",
          "value": "garden"
        },
        {
          "label": "Heavy Equipment",
          "value": "heavy"
        }
      ],
      "type": "select",
      "id": "Field_15",
      "key": "toolCategory",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_14",
        "col": 6
      }
    },
    {
      "label": "Quantity",
      "type": "number",
      "id": "Field_16",
      "key": "quantity",
      "defaultValue": 1,
      "validate": {
        "required": true,
        "min": 1
      },
      "layout": {
        "row": "Row_14",
        "col": 4
      }
    },
    {
      "label": "Special Instructions or Notes",
      "type": "textarea",
      "id": "Field_17",
      "key": "specialInstructions",
      "layout": {
        "row": "Row_15",
        "col": 16
      }
    },
    {
      "text": "### Payment Information",
      "type": "text",
      "id": "Heading_Payment",
      "layout": {
        "row": "Row_16",
        "col": 16
      }
    },
    {
      "label": "Payment Method",
      "values": [
        {
          "label": "Credit Card",
          "value": "creditCard"
        },
        {
          "label": "On Account",
          "value": "account"
        }
      ],
      "type": "radio",
      "id": "Field_18",
      "key": "paymentMethod",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_17",
        "col": 16
      }
    },
    {
      "label": "Cardholder Name",
      "type": "textfield",
      "id": "Field_19",
      "key": "cardholderName",
      "layout": {
        "row": "Row_18",
        "col": 8
      },
      "validate": {
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      }
    },
    {
      "label": "Credit Card Number",
      "type": "textfield",
      "id": "Field_20",
      "key": "creditCardNumber",
      "layout": {
        "row": "Row_18",
        "col": 8
      },
      "validate": {
        "required": true,
        "minLength": 13,
        "maxLength": 19,
        "pattern": "^[0-9\\s]{13,19}$"
      }
    },
    {
      "label": "Expiration Date",
      "type": "textfield",
      "id": "Field_21",
      "key": "expirationDate",
      "description": "MM/YY",
      "layout": {
        "row": "Row_19",
        "col": 4
      },
      "validate": {
        "pattern": "^(0[1-9]|1[0-2])\\/\\d{2}$",
        "maxLength": 255
      }
    },
    {
      "label": "CVV",
      "type": "textfield",
      "id": "Field_22",
      "key": "cvv",
      "layout": {
        "row": "Row_19",
        "col": 4
      },
      "validate": {
        "required": true,
        "minLength": 3,
        "maxLength": 4,
        "pattern": "^[0-9]{3,4}$"
      }
    },
    {
      "label": "Promotional / Discount Code",
      "type": "textfield",
      "id": "Field_23",
      "key": "promoCode",
      "layout": {
        "row": "Row_19",
        "col": 8
      },
      "validate": {
        "maxLength": 30
      }
    },
    {
      "text": "### Agreement",
      "type": "text",
      "id": "Heading_Agreement",
      "layout": {
        "row": "Row_20",
        "col": 16
      }
    },
    {
      "label": "I agree to the Terms and Conditions.",
      "type": "checkbox",
      "id": "Field_24",
      "key": "termsAgreement",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_21",
        "col": 16
      }
    },
    {
      "label": "Digital Signature",
      "type": "textfield",
      "id": "Field_25",
      "key": "digitalSignature",
      "description": "Please type your full name to sign.",
      "validate": {
        "required": true,
        "minLength": 2,
        "maxLength": 100
      },
      "layout": {
        "row": "Row_22",
        "col": 8
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Field_26",
      "key": "signatureDate",
      "dateLabel": "Date of Signature",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_22",
        "col": 8
      }
    }
  ],
  "generated": true,
  "type": "default"
}