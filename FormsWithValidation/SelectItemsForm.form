{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "35a6d3d"
  },
  "schemaVersion": 19,
  "id": "select-items",
  "components": [
    {
      "text": "### Customer Information",
      "type": "text",
      "id": "Heading_customerInfo",
      "layout": {
        "row": "row_0",
        "col": 16
      }
    },
    {
      "label": "Customer ID",
      "type": "textfield",
      "id": "Field_customerID",
      "key": "customerID",
      "description": "Automatically populated for logged-in users.",
      "layout": {
        "row": "row_1",
        "col": 8
      },
      "validate": {
        "required": true,
        "maxLength": 60,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-_/# ]{1,59}$",
        "minLength": 2
      }
    },
    {
      "label": "Session ID",
      "type": "textfield",
      "id": "Field_sessionID",
      "key": "sessionID",
      "description": "Automatically populated for guest users.",
      "layout": {
        "row": "row_1",
        "col": 8
      },
      "validate": {
        "required": true,
        "maxLength": 60,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-_/# ]{1,59}$",
        "minLength": 2
      }
    },
    {
      "text": "### Product Selection",
      "type": "text",
      "id": "Heading_productSelection",
      "layout": {
        "row": "row_2",
        "col": 16
      }
    },
    {
      "label": "Product",
      "values": [
        {
          "label": "SKU-001 - Classic T-Shirt",
          "value": "SKU-001"
        },
        {
          "label": "SKU-002 - Denim Jeans",
          "value": "SKU-002"
        },
        {
          "label": "SKU-003 - Leather Belt",
          "value": "SKU-003"
        }
      ],
      "type": "select",
      "id": "Field_selectedProductID",
      "key": "selectedProductID",
      "description": "Select a product from the list.",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_3",
        "col": 16
      }
    },
    {
      "label": "Product Name",
      "type": "textfield",
      "id": "Field_productName",
      "key": "productName",
      "description": "Populated after product selection.",
      "layout": {
        "row": "row_4",
        "col": 10
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "Unit Price",
      "type": "number",
      "id": "Field_unitPrice",
      "key": "unitPrice",
      "description": "Price per item.",
      "decimalDigits": 2,
      "appearance": {
        "prefixAdorner": "$"
      },
      "layout": {
        "row": "row_4",
        "col": 6
      },
      "validate": {
        "required": true,
        "min": 0,
        "max": 100000000
      }
    },
    {
      "label": "Product Description",
      "type": "textarea",
      "id": "Field_productDescription",
      "key": "productDescription",
      "description": "Populated after product selection.",
      "layout": {
        "row": "row_5",
        "col": 16
      },
      "validate": {
        "maxLength": 1000
      }
    },
    {
      "label": "Available Inventory",
      "type": "number",
      "id": "Field_availableInventory",
      "key": "availableInventory",
      "description": "Current stock level.",
      "layout": {
        "row": "row_6",
        "col": 8
      },
      "validate": {
        "min": 0
      }
    },
    {
      "label": "Selected Quantity",
      "type": "number",
      "id": "Field_selectedQuantity",
      "key": "selectedQuantity",
      "validate": {
        "required": true,
        "min": 1
      },
      "defaultValue": 1,
      "layout": {
        "row": "row_6",
        "col": 8
      }
    },
    {
      "label": "Size",
      "values": [
        {
          "label": "Small",
          "value": "S"
        },
        {
          "label": "Medium",
          "value": "M"
        },
        {
          "label": "Large",
          "value": "L"
        }
      ],
      "type": "select",
      "id": "Field_selectedVariant_Size",
      "key": "selectedVariant_Size",
      "layout": {
        "row": "row_7",
        "col": 5
      }
    },
    {
      "label": "Color",
      "values": [
        {
          "label": "Red",
          "value": "red"
        },
        {
          "label": "Blue",
          "value": "blue"
        },
        {
          "label": "Black",
          "value": "black"
        }
      ],
      "type": "select",
      "id": "Field_selectedVariant_Color",
      "key": "selectedVariant_Color",
      "layout": {
        "row": "row_7",
        "col": 5
      }
    },
    {
      "label": "Material",
      "values": [
        {
          "label": "Cotton",
          "value": "cotton"
        },
        {
          "label": "Polyester",
          "value": "polyester"
        }
      ],
      "type": "select",
      "id": "Field_selectedVariant_Material",
      "key": "selectedVariant_Material",
      "layout": {
        "row": "row_7",
        "col": 6
      }
    },
    {
      "label": "Customization Notes",
      "type": "textarea",
      "id": "Field_customizationNotes",
      "key": "customizationNotes",
      "description": "Add any special instructions, e.g., for engraving.",
      "layout": {
        "row": "row_8",
        "col": 16
      },
      "validate": {
        "maxLength": 1000
      }
    },
    {
      "text": "### Order Summary",
      "type": "text",
      "id": "Heading_orderSummary",
      "layout": {
        "row": "row_9",
        "col": 16
      }
    },
    {
      "label": "Cart Subtotal",
      "type": "number",
      "id": "Field_cartSubtotal",
      "key": "cartSubtotal",
      "description": "Calculated total before discounts and taxes.",
      "decimalDigits": 2,
      "appearance": {
        "prefixAdorner": "$"
      },
      "layout": {
        "row": "row_10",
        "col": 8
      },
      "validate": {
        "min": 0,
        "max": 100000000
      }
    },
    {
      "label": "Total Items in Cart",
      "type": "number",
      "id": "Field_totalNumberOfItems",
      "key": "totalNumberOfItems",
      "description": "Total quantity of all items.",
      "layout": {
        "row": "row_10",
        "col": 8
      },
      "validate": {
        "min": 0,
        "max": 100000000
      }
    },
    {
      "label": "Apply Discount Code",
      "type": "textfield",
      "id": "Field_appliedDiscountCode",
      "key": "appliedDiscountCode",
      "layout": {
        "row": "row_11",
        "col": 16
      },
      "validate": {
        "maxLength": 60,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-_/# ]{1,59}$",
        "minLength": 2
      }
    },
    {
      "label": "Discount",
      "type": "number",
      "id": "Field_discountAmount",
      "key": "discountAmount",
      "description": "Calculated from discount code.",
      "decimalDigits": 2,
      "appearance": {
        "prefixAdorner": "-$"
      },
      "layout": {
        "row": "row_12",
        "col": 8
      },
      "validate": {
        "min": 0,
        "max": 100000000
      }
    },
    {
      "label": "Estimated Tax",
      "type": "number",
      "id": "Field_estimatedTax",
      "key": "estimatedTax",
      "description": "Calculated based on shipping address.",
      "decimalDigits": 2,
      "appearance": {
        "prefixAdorner": "$"
      },
      "layout": {
        "row": "row_12",
        "col": 8
      },
      "validate": {
        "min": 0,
        "max": 100000000
      }
    },
    {
      "label": "Grand Total",
      "type": "number",
      "id": "Field_grandTotal",
      "key": "grandTotal",
      "description": "Final calculated amount.",
      "decimalDigits": 2,
      "appearance": {
        "prefixAdorner": "$"
      },
      "layout": {
        "row": "row_13",
        "col": 16
      },
      "validate": {
        "min": 0,
        "max": 100000000
      }
    },
    {
      "label": "Submit Order",
      "action": "submit",
      "type": "button",
      "id": "Button_submit",
      "layout": {
        "row": "row_14",
        "col": 16
      }
    }
  ],
  "generated": true,
  "type": "default"
}