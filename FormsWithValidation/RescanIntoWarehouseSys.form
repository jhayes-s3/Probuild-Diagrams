{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "35a6d3d"
  },
  "schemaVersion": 19,
  "id": "frescan-into-warehouse-system-form",
  "components": [
    {
      "text": "### Item Rescan Form",
      "type": "text",
      "id": "FormHeading",
      "layout": {
        "row": "Row_1",
        "col": 16
      }
    },
    {
      "text": "### Item Identification",
      "type": "text",
      "id": "ItemIdentificationHeading",
      "layout": {
        "row": "Row_2",
        "col": 16
      }
    },
    {
      "label": "Item Barcode / SKU",
      "type": "textfield",
      "id": "ItemBarcode",
      "key": "itemBarcode",
      "validate": {
        "required": true,
        "maxLength": 60,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-_/# ]{1,59}$",
        "minLength": 2
      },
      "layout": {
        "row": "Row_3",
        "col": 8
      }
    },
    {
      "label": "Serial Number",
      "type": "textfield",
      "id": "SerialNumber",
      "key": "serialNumber",
      "description": "If applicable",
      "layout": {
        "row": "Row_3",
        "col": 4
      },
      "validate": {
        "maxLength": 60,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-_/# ]{1,59}$",
        "minLength": 2
      }
    },
    {
      "label": "Quantity",
      "type": "number",
      "id": "Quantity",
      "key": "quantity",
      "defaultValue": 1,
      "decimalDigits": 0,
      "validate": {
        "required": true,
        "min": 1
      },
      "layout": {
        "row": "Row_3",
        "col": 4
      }
    },
    {
      "text": "### Warehouse Location",
      "type": "text",
      "id": "WarehouseLocationHeading",
      "layout": {
        "row": "Row_4",
        "col": 16
      }
    },
    {
      "label": "Warehouse ID",
      "type": "textfield",
      "id": "WarehouseId",
      "key": "warehouseId",
      "validate": {
        "required": true,
        "maxLength": 60,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-_/# ]{1,59}$",
        "minLength": 2
      },
      "layout": {
        "row": "Row_5",
        "col": 4
      }
    },
    {
      "label": "Aisle Number",
      "type": "textfield",
      "id": "AisleNumber",
      "key": "aisleNumber",
      "validate": {
        "required": true,
        "maxLength": 60,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-_/# ]{1,59}$",
        "minLength": 2
      },
      "layout": {
        "row": "Row_5",
        "col": 4
      }
    },
    {
      "label": "Rack / Shelf ID",
      "type": "textfield",
      "id": "RackId",
      "key": "rackId",
      "validate": {
        "required": true,
        "maxLength": 60,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-_/# ]{1,59}$",
        "minLength": 2
      },
      "layout": {
        "row": "Row_5",
        "col": 4
      }
    },
    {
      "label": "Bin Code",
      "type": "textfield",
      "id": "BinCode",
      "key": "binCode",
      "validate": {
        "required": true,
        "maxLength": 60,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-_/# ]{1,59}$",
        "minLength": 2
      },
      "layout": {
        "row": "Row_5",
        "col": 4
      }
    },
    {
      "text": "### Transaction Details",
      "type": "text",
      "id": "TransactionDetailsHeading",
      "layout": {
        "row": "Row_6",
        "col": 16
      }
    },
    {
      "label": "Operator ID / Username",
      "type": "textfield",
      "id": "OperatorId",
      "key": "operatorId",
      "validate": {
        "required": true,
        "maxLength": 60,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-_/# ]{1,59}$",
        "minLength": 2
      },
      "layout": {
        "row": "Row_7",
        "col": 8
      }
    },
    {
      "subtype": "datetime",
      "type": "datetime",
      "id": "ScanTimestamp",
      "key": "scanTimestamp",
      "dateLabel": "Scan Date",
      "timeLabel": "Scan Time",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_7",
        "col": 8
      },
      "timeInterval": 15
    },
    {
      "label": "Reason for Rescan",
      "values": [
        {
          "label": "Customer Return",
          "value": "customerReturn"
        },
        {
          "label": "Inventory Correction",
          "value": "inventoryCorrection"
        },
        {
          "label": "Mis-pick",
          "value": "misPick"
        }
      ],
      "type": "select",
      "id": "RescanReason",
      "key": "rescanReason",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_8",
        "col": 8
      }
    },
    {
      "label": "Source Document ID",
      "type": "textfield",
      "id": "SourceDocumentId",
      "key": "sourceDocumentId",
      "description": "e.g., RMA Number, Original Picklist ID",
      "layout": {
        "row": "Row_8",
        "col": 8
      },
      "validate": {
        "maxLength": 60,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-_/# ]{1,59}$",
        "minLength": 2
      }
    },
    {
      "text": "### Item Condition",
      "type": "text",
      "id": "ItemConditionHeading",
      "layout": {
        "row": "Row_9",
        "col": 16
      }
    },
    {
      "label": "Condition",
      "values": [
        {
          "label": "New",
          "value": "new"
        },
        {
          "label": "Damaged",
          "value": "damaged"
        },
        {
          "label": "Open Box",
          "value": "openBox"
        }
      ],
      "type": "select",
      "id": "ItemCondition",
      "key": "itemCondition",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_10",
        "col": 16
      }
    },
    {
      "label": "Notes / Comments",
      "type": "textarea",
      "id": "Notes",
      "key": "notes",
      "layout": {
        "row": "Row_11",
        "col": 16
      },
      "validate": {
        "maxLength": 1000
      }
    },
    {
      "text": "### System Fields",
      "type": "text",
      "id": "SystemFieldsHeading",
      "layout": {
        "row": "Row_12",
        "col": 16
      }
    },
    {
      "label": "Transaction ID",
      "type": "textfield",
      "id": "TransactionId",
      "key": "transactionId",
      "defaultValue": "=uuid()",
      "layout": {
        "row": "Row_13",
        "col": 8
      },
      "validate": {
        "maxLength": 60,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-_/# ]{1,59}$",
        "minLength": 2
      }
    },
    {
      "label": "Confirmation Status",
      "type": "textfield",
      "id": "ConfirmationStatus",
      "key": "confirmationStatus",
      "defaultValue": "Pending",
      "layout": {
        "row": "Row_13",
        "col": 8
      },
      "validate": {
        "maxLength": 255
      }
    }
  ],
  "generated": true,
  "type": "default"
}