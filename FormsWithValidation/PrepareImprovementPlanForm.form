{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "35a6d3d"
  },
  "schemaVersion": 19,
  "id": "prepare-improvement-plan-form",
  "components": [
    {
      "text": "### KPI Improvement Plan",
      "type": "text",
      "id": "Heading_kpi_plan",
      "layout": {
        "row": "row_0",
        "col": 16
      }
    },
    {
      "text": "##### KPI Identification",
      "type": "text",
      "id": "Subheading_kpi_id",
      "layout": {
        "row": "row_1",
        "col": 16
      }
    },
    {
      "label": "KPI Name",
      "type": "textfield",
      "id": "Textfield_kpi_name",
      "key": "kpiName",
      "validate": {
        "required": true,
        "maxLength": 255
      },
      "layout": {
        "row": "row_2",
        "col": 8
      }
    },
    {
      "label": "KPI ID / Code",
      "type": "textfield",
      "id": "Textfield_kpi_id",
      "key": "kpiId",
      "validate": {
        "required": true,
        "minLength": 1,
        "maxLength": 50,
        "pattern": "^[A-Za-z0-9\\-]+$"
      },
      "layout": {
        "row": "row_2",
        "col": 8
      }
    },
    {
      "label": "Department / Team",
      "type": "textfield",
      "id": "Textfield_department",
      "key": "department",
      "validate": {
        "required": true,
        "maxLength": 255
      },
      "layout": {
        "row": "row_3",
        "col": 8
      }
    },
    {
      "label": "KPI Owner",
      "type": "textfield",
      "id": "Textfield_kpi_owner",
      "key": "kpiOwner",
      "validate": {
        "required": true,
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      },
      "layout": {
        "row": "row_3",
        "col": 8
      }
    },
    {
      "label": "KPI Description",
      "type": "textarea",
      "id": "Textarea_kpi_description",
      "key": "kpiDescription",
      "layout": {
        "row": "row_4",
        "col": 16
      }
    },
    {
      "text": "##### Performance Analysis",
      "type": "text",
      "id": "Subheading_perf_analysis",
      "layout": {
        "row": "row_5",
        "col": 16
      }
    },
    {
      "label": "Reporting Period",
      "type": "textfield",
      "id": "Textfield_reporting_period",
      "key": "reportingPeriod",
      "layout": {
        "row": "row_6",
        "col": 4
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "Current KPI Value",
      "type": "number",
      "id": "Number_current_value",
      "key": "currentKpiValue",
      "layout": {
        "row": "row_6",
        "col": 4
      }
    },
    {
      "label": "Target KPI Value",
      "type": "number",
      "id": "Number_target_value",
      "key": "targetKpiValue",
      "layout": {
        "row": "row_6",
        "col": 4
      }
    },
    {
      "label": "Performance Gap",
      "type": "number",
      "id": "Number_perf_gap",
      "key": "performanceGap",
      "layout": {
        "row": "row_6",
        "col": 4
      }
    },
    {
      "label": "Root Cause Analysis Summary",
      "type": "textarea",
      "id": "Textarea_root_cause",
      "key": "rootCauseAnalysis",
      "layout": {
        "row": "row_7",
        "col": 16
      }
    },
    {
      "text": "##### Improvement Goal",
      "type": "text",
      "id": "Subheading_improvement_goal",
      "layout": {
        "row": "row_8",
        "col": 16
      }
    },
    {
      "label": "New Target KPI Value",
      "type": "number",
      "id": "Number_new_target",
      "key": "newTargetKpiValue",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_9",
        "col": 8
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Date_target_achievement",
      "key": "targetAchievementDate",
      "dateLabel": "Target Achievement Date",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_9",
        "col": 8
      }
    },
    {
      "label": "Desired Outcome Description",
      "type": "textarea",
      "id": "Textarea_desired_outcome",
      "key": "desiredOutcome",
      "layout": {
        "row": "row_10",
        "col": 16
      }
    },
    {
      "text": "##### Action Plan",
      "type": "text",
      "id": "Subheading_action_plan",
      "layout": {
        "row": "row_11",
        "col": 16
      }
    },
    {
      "label": "Action Item Description",
      "type": "textarea",
      "id": "Textarea_action_item_desc",
      "key": "actionItemDescription",
      "layout": {
        "row": "row_12",
        "col": 16
      }
    },
    {
      "label": "Action Item Owner",
      "type": "textfield",
      "id": "Textfield_action_item_owner",
      "key": "actionItemOwner",
      "layout": {
        "row": "row_13",
        "col": 5
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Date_start_date",
      "key": "startDate",
      "dateLabel": "Start Date",
      "layout": {
        "row": "row_13",
        "col": 4
      },
      "validate": {
        "after": "yesterday"
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Date_due_date",
      "key": "dueDate",
      "dateLabel": "Due Date",
      "layout": {
        "row": "row_13",
        "col": 4
      }
    },
    {
      "label": "Status",
      "values": [
        {
          "label": "Not Started",
          "value": "not_started"
        },
        {
          "label": "In Progress",
          "value": "in_progress"
        },
        {
          "label": "Completed",
          "value": "completed"
        },
        {
          "label": "Blocked",
          "value": "blocked"
        }
      ],
      "type": "select",
      "id": "Select_status",
      "key": "status",
      "layout": {
        "row": "row_13",
        "col": 3
      }
    },
    {
      "label": "Required Resources (Budget, Personnel, Tools)",
      "type": "textarea",
      "id": "Textarea_resources",
      "key": "requiredResources",
      "layout": {
        "row": "row_14",
        "col": 16
      }
    },
    {
      "label": "Dependencies",
      "type": "textarea",
      "id": "Textarea_dependencies",
      "key": "dependencies",
      "layout": {
        "row": "row_15",
        "col": 16
      }
    },
    {
      "text": "##### Monitoring & Review",
      "type": "text",
      "id": "Subheading_monitoring",
      "layout": {
        "row": "row_16",
        "col": 16
      }
    },
    {
      "label": "Review Cadence",
      "values": [
        {
          "label": "Weekly",
          "value": "weekly"
        },
        {
          "label": "Bi-weekly",
          "value": "bi_weekly"
        },
        {
          "label": "Monthly",
          "value": "monthly"
        }
      ],
      "type": "select",
      "id": "Select_review_cadence",
      "key": "reviewCadence",
      "layout": {
        "row": "row_17",
        "col": 8
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Date_next_review",
      "key": "nextReviewDate",
      "dateLabel": "Next Review Date",
      "layout": {
        "row": "row_17",
        "col": 8
      }
    },
    {
      "label": "Progress Metrics",
      "type": "textarea",
      "id": "Textarea_progress_metrics",
      "key": "progressMetrics",
      "layout": {
        "row": "row_18",
        "col": 16
      }
    },
    {
      "label": "Progress Update Notes",
      "type": "textarea",
      "id": "Textarea_progress_notes",
      "key": "progressUpdateNotes",
      "layout": {
        "row": "row_19",
        "col": 16
      }
    },
    {
      "text": "##### Approvals",
      "type": "text",
      "id": "Subheading_approvals",
      "layout": {
        "row": "row_20",
        "col": 16
      }
    },
    {
      "label": "Plan Prepared By",
      "type": "textfield",
      "id": "Textfield_prepared_by",
      "key": "preparedBy",
      "layout": {
        "row": "row_21",
        "col": 8
      },
      "validate": {
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Date_prepared",
      "key": "datePrepared",
      "dateLabel": "Date Prepared",
      "layout": {
        "row": "row_21",
        "col": 8
      }
    },
    {
      "label": "Manager/Approver Name",
      "type": "textfield",
      "id": "Textfield_approver_name",
      "key": "approverName",
      "layout": {
        "row": "row_22",
        "col": 6
      },
      "validate": {
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      }
    },
    {
      "label": "Approval Status",
      "values": [
        {
          "label": "Pending",
          "value": "pending"
        },
        {
          "label": "Approved",
          "value": "approved"
        },
        {
          "label": "Rejected",
          "value": "rejected"
        }
      ],
      "type": "select",
      "id": "Select_approval_status",
      "key": "approvalStatus",
      "layout": {
        "row": "row_22",
        "col": 5
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Date_approval",
      "key": "approvalDate",
      "dateLabel": "Approval Date",
      "layout": {
        "row": "row_22",
        "col": 5
      }
    },
    {
      "label": "Approver Comments",
      "type": "textarea",
      "id": "Textarea_approver_comments",
      "key": "approverComments",
      "layout": {
        "row": "row_23",
        "col": 16
      }
    }
  ],
  "generated": true,
  "type": "default"
}