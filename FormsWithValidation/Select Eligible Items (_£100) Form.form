{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "35a6d3d"
  },
  "schemaVersion": 19,
  "id": "select-eligible-items-form",
  "components": [
    {
      "text": "### Item Management",
      "type": "text",
      "id": "Heading_ItemManagement",
      "layout": {
        "row": "Row_1",
        "col": 16
      }
    },
    {
      "text": "##### Available Item Details",
      "type": "text",
      "id": "Subheading_AvailableItems",
      "layout": {
        "row": "Row_2",
        "col": 16
      }
    },
    {
      "label": "Item ID",
      "type": "textfield",
      "id": "Field_ItemID",
      "key": "itemId",
      "validate": {
        "required": true,
        "maxLength": 60,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-_/# ]{1,59}$",
        "minLength": 2
      },
      "layout": {
        "row": "Row_3",
        "col": 8
      }
    },
    {
      "label": "Item Name",
      "type": "textfield",
      "id": "Field_ItemName",
      "key": "itemName",
      "validate": {
        "required": true,
        "minLength": 3,
        "maxLength": 255
      },
      "layout": {
        "row": "Row_3",
        "col": 8
      }
    },
    {
      "label": "Item Description",
      "type": "textarea",
      "id": "Field_ItemDescription",
      "key": "itemDescription",
      "layout": {
        "row": "Row_4",
        "col": 16
      },
      "validate": {
        "maxLength": 1000
      }
    },
    {
      "label": "Item Price",
      "type": "number",
      "id": "Field_ItemPrice",
      "key": "itemPrice",
      "decimalDigits": 2,
      "appearance": {
        "prefixAdorner": "$"
      },
      "validate": {
        "required": true,
        "min": 0,
        "max": 100000000
      },
      "layout": {
        "row": "Row_5",
        "col": 8
      }
    },
    {
      "text": "##### Selected Eligible Items (Output)",
      "type": "text",
      "id": "Subheading_SelectedItems",
      "layout": {
        "row": "Row_6",
        "col": 16
      }
    },
    {
      "label": "Selected Items",
      "values": [
        {
          "label": "Sample Item A",
          "value": "item_a"
        },
        {
          "label": "Sample Item B",
          "value": "item_b"
        },
        {
          "label": "Sample Item C",
          "value": "item_c"
        }
      ],
      "type": "taglist",
      "id": "Field_SelectedItems",
      "key": "selectedEligibleItems",
      "description": "Select eligible items. This field represents an output.",
      "layout": {
        "row": "Row_7",
        "col": 16
      },
      "validate": {
        "required": true,
        "minLength": 1
      }
    }
  ],
  "generated": true,
  "type": "default"
}