{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "35a6d3d"
  },
  "schemaVersion": 19,
  "id": "pick-items-from-stock",
  "components": [
    {
      "text": "### Warehouse Pick List",
      "type": "text",
      "id": "Heading_main",
      "layout": {
        "row": "row_0",
        "col": 16
      }
    },
    {
      "text": "### Order Information",
      "type": "text",
      "id": "Heading_order_info",
      "layout": {
        "row": "row_1",
        "col": 16
      }
    },
    {
      "label": "Order Number / Pick List ID",
      "type": "textfield",
      "id": "Field_orderNumber",
      "key": "orderNumber",
      "validate": {
        "required": true,
        "maxLength": 255
      },
      "layout": {
        "row": "row_2",
        "col": 8
      }
    },
    {
      "label": "Customer Name",
      "type": "textfield",
      "id": "Field_customerName",
      "key": "customerName",
      "validate": {
        "required": true,
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      },
      "layout": {
        "row": "row_2",
        "col": 8
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Field_orderDate",
      "key": "orderDate",
      "dateLabel": "Order Date",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_3",
        "col": 8
      }
    },
    {
      "text": "### Picker Information",
      "type": "text",
      "id": "Heading_picker_info",
      "layout": {
        "row": "row_4",
        "col": 16
      }
    },
    {
      "label": "Picker Name / Employee ID",
      "type": "textfield",
      "id": "Field_pickerName",
      "key": "pickerName",
      "validate": {
        "required": true,
        "maxLength": 255
      },
      "layout": {
        "row": "row_5",
        "col": 8
      }
    },
    {
      "subtype": "datetime",
      "type": "datetime",
      "id": "Field_pickStartTime",
      "key": "pickStartTime",
      "dateLabel": "Pick Start Date",
      "timeLabel": "Pick Start Time",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_5",
        "col": 8
      },
      "timeInterval": 15
    },
    {
      "text": "### Item Details",
      "type": "text",
      "id": "Heading_item_details",
      "layout": {
        "row": "row_6",
        "col": 16
      }
    },
    {
      "label": "Product SKU / Barcode",
      "type": "textfield",
      "id": "Field_productSku",
      "key": "productSku",
      "validate": {
        "required": true,
        "maxLength": 255
      },
      "layout": {
        "row": "row_7",
        "col": 8
      }
    },
    {
      "label": "Product Name / Description",
      "type": "textfield",
      "id": "Field_productName",
      "key": "productName",
      "layout": {
        "row": "row_7",
        "col": 8
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "Aisle",
      "type": "textfield",
      "id": "Field_locationAisle",
      "key": "locationAisle",
      "layout": {
        "row": "row_8",
        "col": 5
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "Shelf",
      "type": "textfield",
      "id": "Field_locationShelf",
      "key": "locationShelf",
      "layout": {
        "row": "row_8",
        "col": 5
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "Bin Number",
      "type": "textfield",
      "id": "Field_locationBin",
      "key": "locationBin",
      "layout": {
        "row": "row_8",
        "col": 6
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "Unit of Measure",
      "values": [
        {
          "label": "Each",
          "value": "each"
        },
        {
          "label": "Case",
          "value": "case"
        },
        {
          "label": "Kilogram (kg)",
          "value": "kg"
        },
        {
          "label": "Pound (lb)",
          "value": "lb"
        }
      ],
      "type": "select",
      "id": "Field_unitOfMeasure",
      "key": "unitOfMeasure",
      "layout": {
        "row": "row_9",
        "col": 5
      }
    },
    {
      "label": "Quantity Required",
      "type": "number",
      "id": "Field_quantityRequired",
      "key": "quantityRequired",
      "validate": {
        "required": true,
        "min": 0
      },
      "layout": {
        "row": "row_9",
        "col": 5
      }
    },
    {
      "label": "Quantity Picked",
      "type": "number",
      "id": "Field_quantityPicked",
      "key": "quantityPicked",
      "validate": {
        "required": true,
        "min": 0
      },
      "layout": {
        "row": "row_9",
        "col": 6
      }
    },
    {
      "text": "### Discrepancy Reporting",
      "type": "text",
      "id": "Heading_discrepancy",
      "layout": {
        "row": "row_10",
        "col": 16
      }
    },
    {
      "text": "Complete this section only if Quantity Picked is less than Quantity Required.",
      "type": "text",
      "id": "Para_discrepancy_info",
      "layout": {
        "row": "row_11",
        "col": 16
      }
    },
    {
      "label": "Reason for Discrepancy",
      "values": [
        {
          "label": "Insufficient Stock",
          "value": "insufficient_stock"
        },
        {
          "label": "Item Damaged",
          "value": "item_damaged"
        },
        {
          "label": "Item Not Found",
          "value": "item_not_found"
        },
        {
          "label": "Wrong Location",
          "value": "wrong_location"
        }
      ],
      "type": "select",
      "id": "Field_discrepancyReason",
      "key": "discrepancyReason",
      "layout": {
        "row": "row_12",
        "col": 16
      }
    },
    {
      "label": "Notes / Comments",
      "type": "textarea",
      "id": "Field_discrepancyNotes",
      "key": "discrepancyNotes",
      "layout": {
        "row": "row_13",
        "col": 16
      }
    },
    {
      "text": "### Completion Information",
      "type": "text",
      "id": "Heading_completion",
      "layout": {
        "row": "row_14",
        "col": 16
      }
    },
    {
      "subtype": "datetime",
      "type": "datetime",
      "id": "Field_pickEndTime",
      "key": "pickEndTime",
      "dateLabel": "Pick End Date",
      "timeLabel": "Pick End Time",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_15",
        "col": 8
      },
      "timeInterval": 15
    },
    {
      "label": "Total Items Picked",
      "type": "number",
      "id": "Field_totalItemsPicked",
      "key": "totalItemsPicked",
      "validate": {
        "required": true,
        "min": 0
      },
      "layout": {
        "row": "row_15",
        "col": 8
      }
    },
    {
      "label": "Destination for Picked Goods",
      "type": "textfield",
      "id": "Field_destination",
      "key": "destination",
      "description": "e.g., Packing Station ID, Staging Area",
      "validate": {
        "required": true,
        "maxLength": 255
      },
      "layout": {
        "row": "row_16",
        "col": 16
      }
    },
    {
      "label": "I confirm that the information is accurate and the pick is complete.",
      "type": "checkbox",
      "id": "Field_pickerConfirmation",
      "key": "pickerConfirmation",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_17",
        "col": 16
      }
    }
  ],
  "generated": true,
  "type": "default"
}