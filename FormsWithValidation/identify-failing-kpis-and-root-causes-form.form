{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "35a6d3d"
  },
  "schemaVersion": 19,
  "id": "identify-failing-kpis-and-root-causes-form",
  "components": [
    {
      "text": "### KPI Failure Report",
      "type": "text",
      "id": "Heading_kpiFailureReport",
      "layout": {
        "row": "row_00",
        "col": 16
      }
    },
    {
      "text": "##### KPI Identification",
      "type": "text",
      "id": "Subheading_kpiIdentification",
      "layout": {
        "row": "row_01",
        "col": 16
      }
    },
    {
      "label": "KPI Name",
      "type": "textfield",
      "id": "TextField_kpiName",
      "key": "kpiName",
      "validate": {
        "required": true,
        "maxLength": 255
      },
      "layout": {
        "row": "row_02",
        "col": 8
      }
    },
    {
      "label": "KPI ID",
      "type": "textfield",
      "id": "TextField_kpiId",
      "key": "kpiId",
      "validate": {
        "required": true,
        "minLength": 1,
        "maxLength": 50,
        "pattern": "^[A-Za-z0-9\\-]+$"
      },
      "layout": {
        "row": "row_02",
        "col": 8
      }
    },
    {
      "label": "KPI Owner",
      "type": "textfield",
      "id": "TextField_kpiOwner",
      "key": "kpiOwner",
      "validate": {
        "required": true,
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      },
      "layout": {
        "row": "row_03",
        "col": 8
      }
    },
    {
      "label": "Department/Team",
      "type": "textfield",
      "id": "TextField_departmentTeam",
      "key": "departmentTeam",
      "validate": {
        "required": true,
        "maxLength": 255
      },
      "layout": {
        "row": "row_03",
        "col": 8
      }
    },
    {
      "label": "KPI Description/Formula",
      "type": "textarea",
      "id": "TextArea_kpiDescription",
      "key": "kpiDescription",
      "layout": {
        "row": "row_04",
        "col": 16
      }
    },
    {
      "text": "##### Performance Data",
      "type": "text",
      "id": "Subheading_performanceData",
      "layout": {
        "row": "row_05",
        "col": 16
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Date_reportingStart",
      "key": "reportingPeriodStart",
      "dateLabel": "Reporting Period Start Date",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_06",
        "col": 8
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Date_reportingEnd",
      "key": "reportingPeriodEnd",
      "dateLabel": "Reporting Period End Date",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_06",
        "col": 8
      }
    },
    {
      "label": "Target Value/Benchmark",
      "type": "number",
      "id": "Number_targetValue",
      "key": "targetValue",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_07",
        "col": 8
      }
    },
    {
      "label": "Actual Value",
      "type": "number",
      "id": "Number_actualValue",
      "key": "actualValue",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_07",
        "col": 8
      }
    },
    {
      "label": "Variance",
      "type": "number",
      "id": "Number_variance",
      "key": "variance",
      "description": "Difference between Target and Actual",
      "layout": {
        "row": "row_08",
        "col": 8
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Date_failureIdentification",
      "key": "dateOfFailureIdentification",
      "dateLabel": "Date of Failure Identification",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_08",
        "col": 8
      }
    },
    {
      "text": "##### Impact Assessment",
      "type": "text",
      "id": "Subheading_impactAssessment",
      "layout": {
        "row": "row_09",
        "col": 16
      }
    },
    {
      "label": "Business Impact",
      "values": [
        {
          "label": "Low",
          "value": "low"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "High",
          "value": "high"
        },
        {
          "label": "Critical",
          "value": "critical"
        }
      ],
      "type": "select",
      "id": "Select_businessImpact",
      "key": "businessImpact",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_10",
        "col": 16
      }
    },
    {
      "label": "Description of Impact on Business Goals",
      "type": "textarea",
      "id": "TextArea_impactDescription",
      "key": "descriptionOfImpact",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_11",
        "col": 16
      }
    },
    {
      "label": "Affected Stakeholders/Departments",
      "values": [
        {
          "label": "Value",
          "value": "value"
        }
      ],
      "type": "taglist",
      "id": "Taglist_affectedStakeholders",
      "key": "affectedStakeholders",
      "layout": {
        "row": "row_12",
        "col": 16
      }
    },
    {
      "text": "##### Root Cause Analysis",
      "type": "text",
      "id": "Subheading_rootCauseAnalysis",
      "layout": {
        "row": "row_13",
        "col": 16
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Date_analysisStart",
      "key": "analysisStartDate",
      "dateLabel": "Analysis Start Date",
      "layout": {
        "row": "row_14",
        "col": 8
      },
      "validate": {
        "after": "yesterday"
      }
    },
    {
      "label": "Analysis Method Used",
      "values": [
        {
          "label": "5 Whys",
          "value": "5whys"
        },
        {
          "label": "Fishbone",
          "value": "fishbone"
        },
        {
          "label": "Pareto Analysis",
          "value": "pareto"
        }
      ],
      "type": "select",
      "id": "Select_analysisMethod",
      "key": "analysisMethod",
      "layout": {
        "row": "row_14",
        "col": 8
      }
    },
    {
      "label": "Analysis Team/Members",
      "values": [
        {
          "label": "Value",
          "value": "value"
        }
      ],
      "type": "taglist",
      "id": "Taglist_analysisTeam",
      "key": "analysisTeam",
      "layout": {
        "row": "row_15",
        "col": 16
      }
    },
    {
      "label": "Suspected Root Cause(s)",
      "type": "textarea",
      "id": "TextArea_suspectedRootCauses",
      "key": "suspectedRootCauses",
      "layout": {
        "row": "row_16",
        "col": 16
      }
    },
    {
      "label": "Detailed Description of Analysis Findings",
      "type": "textarea",
      "id": "TextArea_analysisFindings",
      "key": "analysisFindings",
      "layout": {
        "row": "row_17",
        "col": 16
      }
    },
    {
      "label": "Confirmed Root Cause",
      "type": "textfield",
      "id": "TextField_confirmedRootCause",
      "key": "confirmedRootCause",
      "layout": {
        "row": "row_18",
        "col": 16
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "text": "##### Corrective Action Plan",
      "type": "text",
      "id": "Subheading_correctiveActionPlan",
      "layout": {
        "row": "row_19",
        "col": 16
      }
    },
    {
      "label": "Proposed Corrective Action(s)",
      "type": "textarea",
      "id": "TextArea_proposedActions",
      "key": "proposedCorrectiveActions",
      "layout": {
        "row": "row_20",
        "col": 16
      }
    },
    {
      "label": "Action Owner(s)",
      "values": [
        {
          "label": "Value",
          "value": "value"
        }
      ],
      "type": "taglist",
      "id": "Taglist_actionOwners",
      "key": "actionOwners",
      "layout": {
        "row": "row_21",
        "col": 8
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Date_actionDueDate",
      "key": "actionDueDate",
      "dateLabel": "Action Due Date",
      "layout": {
        "row": "row_21",
        "col": 8
      }
    },
    {
      "label": "Resources Required",
      "type": "textarea",
      "id": "TextArea_resourcesRequired",
      "key": "resourcesRequired",
      "layout": {
        "row": "row_22",
        "col": 16
      }
    },
    {
      "label": "Success Metrics for Action",
      "type": "textarea",
      "id": "TextArea_successMetrics",
      "key": "successMetrics",
      "layout": {
        "row": "row_23",
        "col": 16
      }
    },
    {
      "label": "Action Status",
      "values": [
        {
          "label": "Not Started",
          "value": "not_started"
        },
        {
          "label": "In Progress",
          "value": "in_progress"
        },
        {
          "label": "Completed",
          "value": "completed"
        }
      ],
      "type": "select",
      "id": "Select_actionStatus",
      "key": "actionStatus",
      "layout": {
        "row": "row_24",
        "col": 16
      }
    },
    {
      "text": "##### Submission Details",
      "type": "text",
      "id": "Subheading_submissionDetails",
      "layout": {
        "row": "row_25",
        "col": 16
      }
    },
    {
      "label": "Reported By (Name)",
      "type": "textfield",
      "id": "TextField_reportedBy",
      "key": "reportedBy",
      "layout": {
        "row": "row_26",
        "col": 8
      },
      "validate": {
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Date_submissionDate",
      "key": "submissionDate",
      "dateLabel": "Submission Date",
      "layout": {
        "row": "row_26",
        "col": 8
      }
    },
    {
      "label": "Reviewer Name",
      "type": "textfield",
