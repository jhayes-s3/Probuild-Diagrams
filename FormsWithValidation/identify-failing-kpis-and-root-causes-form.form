      "key": "reviewerName",
      "layout": {
        "row": "row_27",
        "col": 8
      },
      "validate": {
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Date_reviewDate",
      "key": "reviewDate",
      "dateLabel": "Review Date",
      "layout": {
        "row": "row_27",
        "col": 8
      }
    },
    {
      "label": "Form Status",
      "values": [
        {
          "label": "Open",
          "value": "open"
        },
        {
          "label": "Under Review",
          "value": "under_review"
        },
        {
          "label": "Closed",
