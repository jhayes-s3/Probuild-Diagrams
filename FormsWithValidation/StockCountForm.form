        "required": true,
        "maxLength": 255,
        "pattern": "^[A-Za-z][A-Za-z\\s\\-']{1,99}$",
        "minLength": 2
      }
    },
    {
      "text": "##### Location Details",
      "id": "Subheading_locationDetails",
      "type": "text",
      "layout": {
        "row": "row_9",
        "col": 16
      }
    },
    {
      "label": "Warehouse ID",
      "id": "Textfield_warehouseId",
