      "layout": {
        "row": "row_10",
        "col": 8
      },
      "key": "warehouseId",
      "validate": {
        "required": true,
        "maxLength": 60,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-_/# ]{1,59}$",
        "minLength": 2
      }
    },
    {
      "label": "Aisle Number",
      "id": "Textfield_aisleNumber",
      "type": "textfield",
      "layout": {
        "row": "row_10",
        "col": 8
      },
      "key": "aisleNumber",
      "validate": {
        "required": true,
        "maxLength": 60,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-_/# ]{1,59}$",
        "minLength": 2
      }
    },
    {
      "label": "Bay/Rack Number",
      "id": "Textfield_bayRackNumber",
      "type": "textfield",
      "layout": {
        "row": "row_11",
        "col": 8
      },
      "key": "bayRackNumber",
      "validate": {
        "required": true,
        "maxLength": 60,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-_/# ]{1,59}$",
        "minLength": 2
      }
    },
    {
      "label": "Shelf/Bin Location",
      "id": "Textfield_shelfBinLocation",
      "type": "textfield",
      "layout": {
        "row": "row_11",
        "col": 8
      },
      "key": "shelfBinLocation",
      "validate": {
        "required": true,
        "maxLength": 255,
        "minLength": 2
      }
    },
    {
      "text": "##### Item Details",
      "id": "Subheading_itemDetails",
      "type": "text",
      "layout": {
        "row": "row_12",
        "col": 16
      }
    },
    {
      "label": "Product SKU / Barcode",
      "id": "Textfield_productSku",
      "type": "textfield",
      "layout": {
        "row": "row_13",
        "col": 8
      },
      "key": "productSku",
      "validate": {
        "required": true,
        "maxLength": 60,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-_/# ]{1,59}$",
        "minLength": 2
      }
    },
    {
      "label": "Product Description",
      "id": "Textfield_productDescription",
      "type": "textfield",
      "layout": {
        "row": "row_13",
        "col": 8
      },
      "key": "productDescription",
      "validate": {
        "required": true,
        "maxLength": 255,
        "minLength": 2
      }
    },
    {
      "label": "Unit of Measure",
      "values": [
        {
          "label": "Each",
          "value": "each"
        },
        {
          "label": "Case",
          "value": "case"
        },
        {
          "label": "Pallet",
          "value": "pallet"
        }
      ],
      "id": "Select_unitOfMeasure",
      "type": "select",
      "layout": {
        "row": "row_14",
        "col": 8
      },
      "key": "unitOfMeasure",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Lot Number / Batch Number",
      "id": "Textfield_lotNumber",
      "type": "textfield",
      "layout": {
        "row": "row_14",
        "col": 8
      },
      "key": "lotNumber",
      "validate": {
        "maxLength": 60,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-_/# ]{1,59}$",
        "minLength": 2
      }
    },
    {
      "subtype": "date",
      "id": "Date_expirationDate",
      "type": "datetime",
      "layout": {
        "row": "row_15",
        "col": 8
      },
      "key": "expirationDate",
      "dateLabel": "Expiration Date (if applicable)"
    },
    {
      "text": "##### Count Information",
      "id": "Subheading_countInfo",
      "type": "text",
      "layout": {
        "row": "row_16",
        "col": 16
      }
    },
    {
      "label": "System Quantity (Expected)",
      "id": "Number_systemQty",
      "type": "number",
      "layout": {
        "row": "row_17",
        "col": 8
      },
      "key": "systemQuantity",
      "validate": {
        "required": true,
        "min": 0
      }
    },
    {
      "label": "Physical Count Quantity (Actual)",
      "id": "Number_physicalQty",
      "type": "number",
      "layout": {
        "row": "row_17",
        "col": 8
      },
      "key": "physicalCountQuantity",
      "validate": {
        "required": true,
        "min": 0
      }
    },
    {
      "label": "Variance",
      "id": "Number_variance",
      "type": "number",
      "layout": {
        "row": "row_18",
        "col": 8
      },
      "key": "variance",
      "description": "Automatically calculated or manually entered.",
      "validate": {
        "min": 0
      }
    },
    {
      "label": "Item Condition",
      "values": [
        {
          "label": "Good",
          "value": "good"
        },
        {
          "label": "Damaged",
          "value": "damaged"
        },
        {
          "label": "Expired",
          "value": "expired"
        }
      ],
      "id": "Select_itemCondition",
      "type": "select",
      "layout": {
        "row": "row_19",
        "col": 8
      },
      "key": "itemCondition",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Notes/Comments for Discrepancies",
      "id": "Textarea_notes",
      "type": "textarea",
      "layout": {
        "row": "row_20",
        "col": 16
      },
      "key": "notes",
      "validate": {
        "maxLength": 1000
      }
    },
    {
      "text": "##### Verification",
      "id": "Subheading_verification",
      "type": "text",
      "layout": {
        "row": "row_21",
        "col": 16
      }
    },
    {
      "label": "Counted By (Signature)",
      "id": "Textfield_countedBy",
      "type": "textfield",
      "layout": {
        "row": "row_22",
        "col": 8
      },
      "key": "countedBy",
      "description": "Type full name for signature.",
      "validate": {
        "required": true,
        "maxLength": 255,
        "pattern": "^[A-Za-z][A-Za-z\\s\\-']{1,99}$",
        "minLength": 2
      }
    },
    {
      "label": "Verified By (Signature)",
      "id": "Textfield_verifiedBy",
      "type": "textfield",
      "layout": {
        "row": "row_22",
        "col": 8
      },
      "key": "verifiedBy",
      "description": "Type full name for signature.",
      "validate": {
        "required": true,
        "maxLength": 255,
        "pattern": "^[A-Za-z][A-Za-z\\s\\-']{1,99}$",
        "minLength": 2
      }
    },
    {
      "subtype": "date",
      "id": "Date_verificationDate",
      "type": "datetime",
      "layout": {
        "row": "row_23",
        "col": 8
      },
      "key": "dateOfVerification",
      "dateLabel": "Date of Verification",
      "validate": {
        "required": true
      }
