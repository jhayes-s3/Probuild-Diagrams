      "id": "Subheading_staffInfo",
      "type": "text",
      "layout": {
        "row": "row_6",
        "col": 16
      }
    },
    {
      "label": "Staff Member Name",
      "id": "Textfield_staffName",
      "type": "textfield",
      "layout": {
        "row": "row_7",
        "col": 8
      },
      "key": "staffMemberName",
      "validate": {
        "required": true,
        "maxLength": 255
      }
    },
    {
      "label": "Staff Member ID",
      "id": "Textfield_staffId",
      "type": "textfield",
      "layout": {
        "row": "row_7",
        "col": 8
      },
      "key": "staffMemberId",
      "validate": {
        "required": true,
        "maxLength": 60,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-_/# ]{1,59}$",
        "minLength": 2
      }
    },
    {
      "label": "Supervisor Name",
      "id": "Textfield_supervisorName",
