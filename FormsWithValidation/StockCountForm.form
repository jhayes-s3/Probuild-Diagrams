{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "35a6d3d"
  },
  "schemaVersion": 19,
  "id": "count-stock-items-form",
  "components": [
    {
      "text": "### Stock Count Form",
      "id": "Heading_main",
      "type": "text",
      "layout": {
        "row": "row_0",
        "col": 16
      }
    },
    {
      "text": "##### Form Details",
      "id": "Subheading_formDetails",
      "type": "text",
      "layout": {
        "row": "row_1",
        "col": 16
      }
    },
    {
      "label": "Stock Count ID",
      "id": "Textfield_stockCountId",
      "type": "textfield",
      "layout": {
        "row": "row_2",
        "col": 8
      },
      "key": "stockCountId",
      "validate": {
        "required": true,
        "maxLength": 60,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-_/# ]{1,59}$",
        "minLength": 2
      }
    },
    {
      "subtype": "date",
      "id": "Date_countDate",
      "type": "datetime",
      "layout": {
        "row": "row_3",
        "col": 8
      },
      "key": "dateOfCount",
      "dateLabel": "Date of Count",
      "validate": {
        "required": true
      }
    },
    {
      "subtype": "time",
      "id": "Time_startTime",
      "type": "datetime",
      "layout": {
        "row": "row_4",
        "col": 8
      },
      "key": "startTime",
      "timeLabel": "Start Time",
      "validate": {
        "required": true
      },
      "timeInterval": 15
    },
    {
      "subtype": "time",
      "id": "Time_endTime",
      "type": "datetime",
      "layout": {
        "row": "row_5",
        "col": 8
      },
      "key": "endTime",
      "timeLabel": "End Time",
      "validate": {
        "required": true
      },
      "timeInterval": 15
    },
    {
