{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "35a6d3d"
  },
  "schemaVersion": 19,
  "id": "pack-items",
  "components": [
    {
      "text": "### Packing Slip & Verification",
      "type": "text",
      "id": "Heading_main",
      "layout": {
        "row": "Row_0",
        "col": 16
      }
    },
    {
      "text": "##### Order Information",
      "type": "text",
      "id": "Subheading_order_info",
      "layout": {
        "row": "Row_1",
        "col": 16
      }
    },
    {
      "label": "Order Number",
      "type": "textfield",
      "id": "Field_orderNumber",
      "key": "orderNumber",
      "validate": {
        "required": true,
        "maxLength": 255
      },
      "layout": {
        "row": "Row_2",
        "col": 8
      }
    },
    {
      "label": "Customer Name",
      "type": "textfield",
      "id": "Field_customerName",
      "key": "customerName",
      "validate": {
        "required": true,
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      },
      "layout": {
        "row": "Row_2",
        "col": 8
      }
    },
    {
      "text": "##### Item Packing List",
      "type": "text",
      "id": "Subheading_item_list",
      "layout": {
        "row": "Row_3",
        "col": 16
      }
    },
    {
      "label": "SKU / Item ID",
      "type": "textfield",
      "id": "Field_sku",
      "key": "sku",
      "layout": {
        "row": "Row_4",
        "col": 8
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "Product Name",
      "type": "textfield",
      "id": "Field_productName",
      "key": "productName",
      "layout": {
        "row": "Row_4",
        "col": 8
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "Quantity to Pack",
      "type": "number",
      "id": "Field_quantityToPack",
      "key": "quantityToPack",
      "layout": {
        "row": "Row_5",
        "col": 8
      },
      "validate": {
        "min": 0
      }
    },
    {
      "label": "Quantity Packed",
      "type": "number",
      "id": "Field_quantityPacked",
      "key": "quantityPacked",
      "validate": {
        "required": true,
        "min": 0
      },
      "layout": {
        "row": "Row_5",
        "col": 8
      }
    },
    {
      "label": "Item Scanned",
      "type": "checkbox",
      "id": "Field_itemScanned",
      "key": "itemScanned",
      "layout": {
        "row": "Row_6",
        "col": 16
      }
    },
    {
      "text": "##### Packaging Details",
      "type": "text",
      "id": "Subheading_packaging",
      "layout": {
        "row": "Row_7",
        "col": 16
      }
    },
    {
      "label": "Box Size Used",
      "values": [
        {
          "label": "Small",
          "value": "small"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Large",
          "value": "large"
        },
        {
          "label": "Extra Large",
          "value": "xlarge"
        }
      ],
      "type": "select",
      "id": "Field_boxSize",
      "key": "boxSize",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_8",
        "col": 6
      }
    },
    {
      "label": "Final Package Weight",
      "type": "number",
      "id": "Field_packageWeight",
      "key": "packageWeight",
      "appearance": {
        "suffixAdorner": "kg"
      },
      "validate": {
        "required": true,
        "min": 0
      },
      "layout": {
        "row": "Row_8",
        "col": 5
      }
    },
    {
      "label": "Number of Boxes",
      "type": "number",
      "id": "Field_boxCount",
      "key": "boxCount",
      "defaultValue": 1,
      "validate": {
        "required": true,
        "min": 1
      },
      "layout": {
        "row": "Row_8",
        "col": 5
      }
    },
    {
      "text": "##### Staff & Station Information",
      "type": "text",
      "id": "Subheading_staff",
      "layout": {
        "row": "Row_9",
        "col": 16
      }
    },
    {
      "label": "Packer Name / Employee ID",
      "type": "textfield",
      "id": "Field_packerId",
      "key": "packerId",
      "validate": {
        "required": true,
        "maxLength": 255
      },
      "layout": {
        "row": "Row_10",
        "col": 8
      }
    },
    {
      "label": "Packing Station ID",
      "type": "textfield",
      "id": "Field_stationId",
      "key": "stationId",
      "validate": {
        "required": true,
        "maxLength": 255
      },
      "layout": {
        "row": "Row_10",
        "col": 8
      }
    },
    {
      "subtype": "datetime",
      "type": "datetime",
      "id": "Field_packingStart",
      "key": "packingStart",
      "dateLabel": "Packing Start Date",
      "timeLabel": "Time",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_11",
        "col": 8
      },
      "timeInterval": 15
    },
    {
      "subtype": "datetime",
      "type": "datetime",
      "id": "Field_packingEnd",
      "key": "packingEnd",
      "dateLabel": "Packing End Date",
      "timeLabel": "Time",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_11",
        "col": 8
      },
      "timeInterval": 15
    },
    {
      "text": "##### Quality & Verification",
      "type": "text",
      "id": "Subheading_quality",
      "layout": {
        "row": "Row_12",
        "col": 16
      }
    },
    {
      "label": "Items Weighed",
      "type": "checkbox",
      "id": "Field_itemsWeighed",
      "key": "itemsWeighed",
      "layout": {
        "row": "Row_13",
        "col": 8
      }
    },
    {
      "label": "Quality Check Passed",
      "type": "checkbox",
      "id": "Field_qualityCheckPassed",
      "key": "qualityCheckPassed",
      "layout": {
        "row": "Row_13",
        "col": 8
      }
    },
    {
      "label": "Discrepancy Notes",
      "type": "textarea",
      "id": "Field_discrepancyNotes",
      "key": "discrepancyNotes",
      "description": "e.g., damaged item, quantity mismatch",
      "layout": {
        "row": "Row_14",
        "col": 16
      }
    },
    {
      "text": "##### Shipping Information",
      "type": "text",
      "id": "Subheading_shipping",
      "layout": {
        "row": "Row_15",
        "col": 16
      }
    },
    {
      "label": "Shipping Label ID / Tracking Number",
      "type": "textfield",
      "id": "Field_trackingNumber",
      "key": "trackingNumber",
      "layout": {
        "row": "Row_16",
        "col": 16
      },
      "validate": {
        "minLength": 1,
        "maxLength": 50,
        "pattern": "^[A-Za-z0-9\\-]+$"
      }
    },
    {
      "text": "##### Confirmation",
      "type": "text",
      "id": "Subheading_confirmation",
      "layout": {
        "row": "Row_17",
        "col": 16
      }
    },
    {
      "label": "Packer Signature",
      "type": "textfield",
      "id": "Field_packerSignature",
      "key": "packerSignature",
      "description": "Type your full name to sign.",
      "validate": {
        "required": true,
        "minLength": 2,
        "maxLength": 100
      },
      "layout": {
        "row": "Row_18",
        "col": 16
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Field_completionDate",
      "key": "completionDate",
      "dateLabel": "Date",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_19",
        "col": 16
      }
    }
  ],
  "generated": true,
  "type": "default"
}