{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "35a6d3d"
  },
  "schemaVersion": 19,
  "id": "make-order",
  "components": [
    {
      "text": "### New Order Form",
      "type": "text",
      "id": "Heading_NewOrder",
      "layout": {
        "row": "row_0",
        "col": 16
      }
    },
    {
      "text": "### Customer Information",
      "type": "text",
      "level": "2",
      "id": "Heading_CustomerInfo",
      "layout": {
        "row": "row_1",
        "col": 16
      }
    },
    {
      "label": "Customer ID (if existing)",
      "type": "textfield",
      "id": "Textfield_CustomerID",
      "key": "customerId",
      "layout": {
        "row": "row_2",
        "col": 8
      },
      "validate": {
        "minLength": 1,
        "maxLength": 50,
        "pattern": "^[A-Za-z0-9\\-]+$"
      }
    },
    {
      "label": "Full Name",
      "type": "textfield",
      "id": "Textfield_FullName",
      "key": "customerFullName",
      "validate": {
        "required": true,
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      },
      "layout": {
        "row": "row_2",
        "col": 8
      }
    },
    {
      "label": "Company Name (optional)",
      "type": "textfield",
      "id": "Textfield_CompanyName",
      "key": "customerCompanyName",
      "layout": {
        "row": "row_3",
        "col": 16
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "Email Address",
      "type": "textfield",
      "id": "Textfield_Email",
      "key": "customerEmail",
      "validate": {
        "required": true,
        "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
        "maxLength": 255
      },
      "layout": {
        "row": "row_4",
        "col": 8
      }
    },
    {
      "label": "Phone Number",
      "type": "textfield",
      "id": "Textfield_Phone",
      "key": "customerPhone",
      "validate": {
        "required": true,
        "pattern": "^[\\+]?[\\d\\s\\-\\(\\)]{7,15}$",
        "maxLength": 255
      },
      "layout": {
        "row": "row_4",
        "col": 8
      }
    },
    {
      "text": "### Shipping Information",
      "type": "text",
      "level": "2",
      "id": "Heading_ShippingInfo",
      "layout": {
        "row": "row_5",
        "col": 16
      }
    },
    {
      "label": "Recipient Name",
      "type": "textfield",
      "id": "Textfield_RecipientName",
      "key": "shippingRecipientName",
      "validate": {
        "required": true,
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      },
      "layout": {
        "row": "row_6",
        "col": 16
      }
    },
    {
      "label": "Street Address",
      "type": "textfield",
      "id": "Textfield_ShippingStreet",
      "key": "shippingStreet",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_7",
        "col": 16
      }
    },
    {
      "label": "City",
      "type": "textfield",
      "id": "Textfield_ShippingCity",
      "key": "shippingCity",
      "validate": {
        "required": true,
        "maxLength": 50,
        "pattern": "^[A-Za-z\\s\\-']+$"
      },
      "layout": {
        "row": "row_8",
        "col": 6
      }
    },
    {
      "label": "State",
      "type": "textfield",
      "id": "Textfield_ShippingState",
      "key": "shippingState",
      "validate": {
        "required": true,
        "minLength": 2,
        "maxLength": 2,
        "pattern": "^[A-Z]{2}$"
      },
      "layout": {
        "row": "row_8",
        "col": 5
      }
    },
    {
      "label": "ZIP / Postal Code",
      "type": "textfield",
      "id": "Textfield_ShippingZip",
      "key": "shippingZip",
      "validate": {
        "required": true,
        "pattern": "^\\d{5}(\\-\\d{4})?$",
        "maxLength": 255
      },
      "layout": {
        "row": "row_8",
        "col": 5
      }
    },
    {
      "label": "Country",
      "values": [
        {
          "label": "United States",
          "value": "US"
        },
        {
          "label": "Canada",
          "value": "CA"
        },
        {
          "label": "Germany",
          "value": "DE"
        },
        {
          "label": "United Kingdom",
          "value": "GB"
        }
      ],
      "type": "select",
      "id": "Select_ShippingCountry",
      "key": "shippingCountry",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_9",
        "col": 8
      }
    },
    {
      "label": "Shipping Method",
      "values": [
        {
          "label": "Standard",
          "value": "standard"
        },
        {
          "label": "Express",
          "value": "express"
        },
        {
          "label": "Overnight",
          "value": "overnight"
        }
      ],
      "type": "select",
      "id": "Select_ShippingMethod",
      "key": "shippingMethod",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_9",
        "col": 8
      }
    },
    {
      "text": "### Billing Information",
      "type": "text",
      "level": "2",
      "id": "Heading_BillingInfo",
      "layout": {
        "row": "row_10",
        "col": 16
      }
    },
    {
      "label": "Use same as shipping information",
      "type": "checkbox",
      "id": "Checkbox_SameAsShipping",
      "key": "billingSameAsShipping",
      "layout": {
        "row": "row_11",
        "col": 16
      }
    },
    {
      "label": "Billing Name",
      "type": "textfield",
      "id": "Textfield_BillingName",
      "key": "billingName",
      "layout": {
        "row": "row_12",
        "col": 16
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "Street Address",
      "type": "textfield",
      "id": "Textfield_BillingStreet",
      "key": "billingStreet",
      "layout": {
        "row": "row_13",
        "col": 16
      }
    },
    {
      "label": "City",
      "type": "textfield",
      "id": "Textfield_BillingCity",
      "key": "billingCity",
      "layout": {
        "row": "row_14",
        "col": 6
      },
      "validate": {
        "maxLength": 50,
        "pattern": "^[A-Za-z\\s\\-']+$"
      }
    },
    {
      "label": "State",
      "type": "textfield",
      "id": "Textfield_BillingState",
      "key": "billingState",
      "layout": {
        "row": "row_14",
        "col": 5
      },
      "validate": {
        "minLength": 2,
        "maxLength": 2,
        "pattern": "^[A-Z]{2}$"
      }
    },
    {
      "label": "ZIP / Postal Code",
      "type": "textfield",
      "id": "Textfield_BillingZip",
      "key": "billingZip",
      "layout": {
        "row": "row_14",
        "col": 5
      },
      "validate": {
        "pattern": "^\\d{5}(\\-\\d{4})?$",
        "maxLength": 255
      }
    },
    {
      "label": "Country",
      "values": [
        {
          "label": "United States",
          "value": "US"
        },
        {
          "label": "Canada",
          "value": "CA"
        },
        {
          "label": "Germany",
          "value": "DE"
        },
        {
          "label": "United Kingdom",
          "value": "GB"
        }
      ],
      "type": "select",
      "id": "Select_BillingCountry",
      "key": "billingCountry",
      "layout": {
        "row": "row_15",
        "col": 16
      }
    },
    {
      "text": "### Order Details (Line Items)",
      "type": "text",
      "level": "2",
      "id": "Heading_OrderDetails",
      "layout": {
        "row": "row_16",
        "col": 16
      }
    },
    {
      "label": "Product/Service ID or SKU",
      "type": "textfield",
      "id": "Textfield_ProductID",
      "key": "lineItemSku",
      "layout": {
        "row": "row_17",
        "col": 8
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "Product/Service Name",
      "type": "textfield",
      "id": "Textfield_ProductName",
      "key": "lineItemName",
      "layout": {
        "row": "row_17",
        "col": 8
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "Description",
      "type": "textarea",
      "id": "Textarea_ProductDesc",
      "key": "lineItemDescription",
      "layout": {
        "row": "row_18",
        "col": 16
      }
    },
    {
      "label": "Quantity",
      "type": "number",
      "id": "Number_Quantity",
      "key": "lineItemQuantity",
      "validate": {
        "min": 1
      },
      "layout": {
        "row": "row_19",
        "col": 4
      }
    },
    {
      "label": "Unit Price",
      "type": "number",
      "id": "Number_UnitPrice",
      "key": "lineItemUnitPrice",
      "decimalDigits": 2,
      "appearance": {
        "prefixAdorner": "$"
      },
      "layout": {
        "row": "row_19",
        "col": 6
      },
      "validate": {
        "min": 0
      }
    },
    {
      "label": "Line Total",
      "type": "number",
      "id": "Number_LineTotal",
      "key": "lineItemTotal",
      "decimalDigits": 2,
      "appearance": {
        "prefixAdorner": "$"
      },
      "layout": {
        "row": "row_19",
        "col": 6
      },
      "validate": {
        "min": 0
      }
    },
    {
      "text": "### Payment Information",
      "type": "text",
      "level": "2",
      "id": "Heading_PaymentInfo",
      "layout": {
        "row": "row_20",
        "col": 16
      }
    },
    {
      "label": "Payment Method",
      "values": [
        {
          "label": "Credit Card",
          "value": "creditCard"
        },
        {
          "label": "PayPal",
          "value": "paypal"
        },
        {
          "label": "Purchase Order",
          "value": "purchaseOrder"
        }
      ],
      "type": "radio",
      "id": "Radio_PaymentMethod",
      "key": "paymentMethod",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_21",
        "col": 16
      }
    },
    {
      "label": "Cardholder Name",
      "type": "textfield",
      "id": "Textfield_CardholderName",
      "key": "paymentCardholderName",
      "layout": {
        "row": "row_22",
        "col": 16
      },
      "validate": {
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      }
    },
    {
      "label": "Credit Card Number",
      "type": "textfield",
      "id": "Textfield_CardNumber",
      "key": "paymentCardNumber",
      "layout": {
        "row": "row_23",
        "col": 16
      },
      "validate": {
        "required": true,
        "minLength": 13,
        "maxLength": 19,
        "pattern": "^[0-9\\s]{13,19}$"
      }
    },
    {
      "label": "Expiration Date (MM/YY)",
      "type": "textfield",
      "id": "Textfield_CardExpiry",
      "key": "paymentCardExpiry",
      "layout": {
        "row": "row_24",
        "col": 8
      },
      "validate": {
        "pattern": "^(0[1-9]|1[0-2])\\/\\d{2}$",
        "maxLength": 255
      }
    },
    {
      "label": "CVV/Security Code",
      "type": "textfield",
      "id": "Textfield_CardCvv",
      "key": "paymentCardCvv",
      "layout": {
        "row": "row_24",
        "col": 8
      },
      "validate": {
        "required": true,
        "minLength": 3,
        "maxLength": 4,
        "pattern": "^[0-9]{3,4}$"
      }
    },
    {
      "label": "Purchase Order Number",
      "type": "textfield",
      "id": "Textfield_PurchaseOrder",
      "key": "paymentPurchaseOrderNum",
      "layout": {
        "row": "row_25",
        "col": 16
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "text": "### Order Summary",
      "type": "text",
      "level": "2",
      "id": "Heading_OrderSummary",
      "layout": {
        "row": "row_26",
        "col": 16
      }
    },
    {
      "label": "Subtotal",
      "type": "number",
      "id": "Number_Subtotal",
      "key": "summarySubtotal",
      "decimalDigits": 2,
      "appearance": {
        "prefixAdorner": "$"
      },
      "layout": {
        "row": "row_27",
        "col": 8
      },
      "validate": {
        "min": 0
      }
    },
    {
      "label": "Discounts/Promotions",
      "type": "number",
      "id": "Number_Discounts",
      "key": "summaryDiscounts",
      "decimalDigits": 2,
      "appearance": {
        "prefixAdorner": "$"
      },
      "layout": {
        "row": "row_27",
        "col": 8
      },
      "validate": {
        "min": 0
      }
    },
    {
      "label": "Shipping & Handling",
      "type": "number",
      "id": "Number_ShippingCost",
      "key": "summaryShipping",
      "decimalDigits": 2,
      "appearance": {
        "prefixAdorner": "$"
      },
      "layout": {
        "row": "row_28",
        "col": 8
      },
      "validate": {
        "min": 0
      }
    },
    {
      "label": "Taxes",
      "type": "number",
      "id": "Number_Taxes",
      "key": "summaryTaxes",
      "decimalDigits": 2,
      "appearance": {
        "prefixAdorner": "$"
      },
      "layout": {
        "row": "row_28",
        "col": 8
      },
      "validate": {
        "min": 0
      }
    },
    {
      "label": "Order Total",
      "type": "number",
      "id": "Number_OrderTotal",
      "key": "summaryOrderTotal",
      "decimalDigits": 2,
      "appearance": {
        "prefixAdorner": "$"
      },
      "layout": {
        "row": "row_29",
        "col": 16
      },
      "validate": {
        "min": 0
      }
    },
    {
      "text": "### Additional Information",
      "type": "text",
      "level": "2",
      "id": "Heading_AdditionalInfo",
      "layout": {
        "row": "row_30",
        "col": 16
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Date_OrderDate",
      "key": "orderDate",
      "dateLabel": "Order Date",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_31",
        "col": 16
      }
    },
    {
      "label": "Special Instructions or Notes",
      "type": "textarea",
      "id": "Textarea_SpecialInstructions",
      "key": "specialInstructions",
      "layout": {
        "row": "row_32",
        "col": 16
      }
    },
    {
      "label": "Gift Message (optional)",
      "type": "textarea",
      "id": "Textarea_GiftMessage",
      "key": "giftMessage",
      "layout": {
        "row": "row_33",
        "col": 16
      }
    },
    {
      "label": "I agree to the Terms & Conditions",
      "type": "checkbox",
      "id": "Checkbox_Terms",
      "key": "agreedToTerms",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_34",
        "col": 16
      }
    },
    {
      "label": "Submit Order",
      "action": "submit",
      "type": "button",
      "id": "Button_Submit",
      "layout": {
        "row": "row_35",
        "col": 16
      }
    }
  ],
  "generated": true,
  "type": "default"
}