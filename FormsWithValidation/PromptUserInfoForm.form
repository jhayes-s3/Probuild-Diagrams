{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "35a6d3d"
  },
  "schemaVersion": 19,
  "id": "prompt-user-for-information",
  "components": [
    {
      "text": "### Checkout",
      "type": "text",
      "id": "Heading_checkout",
      "layout": {
        "row": "row_0",
        "col": 16
      }
    },
    {
      "text": "### Contact Information",
      "type": "text",
      "id": "Heading_contact",
      "layout": {
        "row": "row_1",
        "col": 16
      }
    },
    {
      "label": "Email Address",
      "type": "textfield",
      "id": "Textfield_email",
      "key": "emailAddress",
      "validate": {
        "required": true,
        "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
      },
      "layout": {
        "row": "row_2",
        "col": 16
      }
    },
    {
      "text": "### Shipping Information",
      "type": "text",
      "id": "Heading_shipping",
      "layout": {
        "row": "row_3",
        "col": 16
      }
    },
    {
      "label": "Full Name",
      "type": "textfield",
      "id": "Textfield_shipping_fullName",
      "key": "shippingFullName",
      "validate": {
        "required": true,
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      },
      "layout": {
        "row": "row_4",
        "col": 16
      }
    },
    {
      "label": "Street Address",
      "type": "textfield",
      "id": "Textfield_shipping_street",
      "key": "shippingStreetAddress",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_5",
        "col": 16
      }
    },
    {
      "label": "Apartment, suite, etc.",
      "type": "textfield",
      "id": "Textfield_shipping_apt",
      "key": "shippingApt",
      "description": "(optional)",
      "layout": {
        "row": "row_6",
        "col": 16
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "City",
      "type": "textfield",
      "id": "Textfield_shipping_city",
      "key": "shippingCity",
      "validate": {
        "required": true,
        "maxLength": 50,
        "pattern": "^[A-Za-z\\s\\-']+$"
      },
      "layout": {
        "row": "row_7",
        "col": 6
      }
    },
    {
      "label": "State/Province",
      "type": "textfield",
      "id": "Textfield_shipping_state",
      "key": "shippingState",
      "validate": {
        "required": true,
        "minLength": 2,
        "maxLength": 2,
        "pattern": "^[A-Z]{2}$"
      },
      "layout": {
        "row": "row_7",
        "col": 5
      }
    },
    {
      "label": "ZIP/Postal Code",
      "type": "textfield",
      "id": "Textfield_shipping_zip",
      "key": "shippingZip",
      "validate": {
        "required": true,
        "pattern": "^\\d{5}(\\-\\d{4})?$",
        "maxLength": 255
      },
      "layout": {
        "row": "row_7",
        "col": 5
      }
    },
    {
      "label": "Country",
      "type": "textfield",
      "id": "Textfield_shipping_country",
      "key": "shippingCountry",
      "validate": {
        "required": true,
        "maxLength": 255
      },
      "layout": {
        "row": "row_8",
        "col": 16
      }
    },
    {
      "label": "Phone Number",
      "type": "textfield",
      "id": "Textfield_shipping_phone",
      "key": "shippingPhone",
      "description": "For delivery updates",
      "validate": {
        "required": true,
        "pattern": "^[\\+]?[\\d\\s\\-\\(\\)]{7,15}$",
        "maxLength": 255
      },
      "layout": {
        "row": "row_9",
        "col": 16
      }
    },
    {
      "text": "### Payment Information",
      "type": "text",
      "id": "Heading_payment",
      "layout": {
        "row": "row_10",
        "col": 16
      }
    },
    {
      "label": "Credit Card Number",
      "type": "textfield",
      "id": "Textfield_cc_number",
      "key": "creditCardNumber",
      "validate": {
        "required": true,
        "minLength": 13,
        "maxLength": 19,
        "pattern": "^[0-9\\s]{13,19}$"
      },
      "layout": {
        "row": "row_11",
        "col": 16
      }
    },
    {
      "label": "Name on Card",
      "type": "textfield",
      "id": "Textfield_cc_name",
      "key": "nameOnCard",
      "validate": {
        "required": true,
        "maxLength": 255
      },
      "layout": {
        "row": "row_12",
        "col": 16
      }
    },
    {
      "label": "Expiration Date (MM/YY)",
      "type": "textfield",
      "id": "Textfield_cc_exp",
      "key": "expirationDate",
      "validate": {
        "required": true,
        "pattern": "^(0[1-9]|1[0-2])\\/\\d{2}$",
        "maxLength": 255
      },
      "layout": {
        "row": "row_13",
        "col": 8
      }
    },
    {
      "label": "Security Code (CVV)",
      "type": "textfield",
      "id": "Textfield_cc_cvv",
      "key": "securityCode",
      "validate": {
        "required": true,
        "minLength": 3,
        "maxLength": 4,
        "pattern": "^[0-9]{3,4}$"
      },
      "layout": {
        "row": "row_13",
        "col": 8
      }
    },
    {
      "text": "### Billing Address",
      "type": "text",
      "id": "Heading_billing",
      "layout": {
        "row": "row_14",
        "col": 16
      }
    },
    {
      "label": "Use same as shipping address",
      "type": "checkbox",
      "id": "Checkbox_same_address",
      "key": "sameAsShipping",
      "layout": {
        "row": "row_15",
        "col": 16
      }
    },
    {
      "label": "Full Name",
      "type": "textfield",
      "id": "Textfield_billing_fullName",
      "key": "billingFullName",
      "layout": {
        "row": "row_16",
        "col": 16
      },
      "validate": {
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      }
    },
    {
      "label": "Street Address",
      "type": "textfield",
      "id": "Textfield_billing_street",
      "key": "billingStreetAddress",
      "layout": {
        "row": "row_17",
        "col": 16
      }
    },
    {
      "label": "Apartment, suite, etc.",
      "type": "textfield",
      "id": "Textfield_billing_apt",
      "key": "billingApt",
      "description": "(optional)",
      "layout": {
        "row": "row_18",
        "col": 16
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "City",
      "type": "textfield",
      "id": "Textfield_billing_city",
      "key": "billingCity",
      "layout": {
        "row": "row_19",
        "col": 6
      },
      "validate": {
        "maxLength": 50,
        "pattern": "^[A-Za-z\\s\\-']+$"
      }
    },
    {
      "label": "State/Province",
      "type": "textfield",
      "id": "Textfield_billing_state",
      "key": "billingState",
      "layout": {
        "row": "row_19",
        "col": 5
      },
      "validate": {
        "minLength": 2,
        "maxLength": 2,
        "pattern": "^[A-Z]{2}$"
      }
    },
    {
      "label": "ZIP/Postal Code",
      "type": "textfield",
      "id": "Textfield_billing_zip",
      "key": "billingZip",
      "layout": {
        "row": "row_19",
        "col": 5
      },
      "validate": {
        "pattern": "^\\d{5}(\\-\\d{4})?$",
        "maxLength": 255
      }
    },
    {
      "label": "Country",
      "type": "textfield",
      "id": "Textfield_billing_country",
      "key": "billingCountry",
      "layout": {
        "row": "row_20",
        "col": 16
      },
      "validate": {
        "maxLength": 255
      }
    }
  ],
  "generated": true,
  "type": "default"
}