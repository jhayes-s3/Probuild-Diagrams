{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "35a6d3d"
  },
  "schemaVersion": 19,
  "id": "inspect-tool-condition-form",
  "components": [
    {
      "text": "### Tool Return Inspection Form",
      "type": "text",
      "id": "Heading_main",
      "layout": {
        "row": "row_0",
        "col": 16
      }
    },
    {
      "text": "##### Return & Tool Identification",
      "type": "text",
      "id": "Subheading_return_tool_id",
      "layout": {
        "row": "row_1",
        "col": 16
      }
    },
    {
      "label": "Return Authorization Number (RMA)",
      "type": "textfield",
      "id": "Field_rma",
      "key": "rmaNumber",
      "validate": {
        "required": true,
        "minLength": 1,
        "maxLength": 50,
        "pattern": "^[A-Za-z0-9\\-]+$"
      },
      "layout": {
        "row": "row_2",
        "col": 8
      }
    },
    {
      "label": "Original Order Number",
      "type": "textfield",
      "id": "Field_orderNumber",
      "key": "originalOrderNumber",
      "validate": {
        "required": true,
        "maxLength": 255
      },
      "layout": {
        "row": "row_2",
        "col": 8
      }
    },
    {
      "label": "Customer Name",
      "type": "textfield",
      "id": "Field_customerName",
      "key": "customerName",
      "validate": {
        "required": true,
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      },
      "layout": {
        "row": "row_3",
        "col": 16
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Field_dateOfReturn",
      "key": "dateOfReturn",
      "dateLabel": "Date of Return",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_4",
        "col": 16
      }
    },
    {
      "label": "Tool Name/Description",
      "type": "textfield",
      "id": "Field_toolName",
      "key": "toolName",
      "validate": {
        "required": true,
        "maxLength": 255
      },
      "layout": {
        "row": "row_5",
        "col": 16
      }
    },
    {
      "label": "Tool SKU / Part Number",
      "type": "textfield",
      "id": "Field_toolSku",
      "key": "toolSku",
      "validate": {
        "required": true,
        "maxLength": 255
      },
      "layout": {
        "row": "row_6",
        "col": 8
      }
    },
    {
      "label": "Tool Serial Number",
      "type": "textfield",
      "id": "Field_toolSerial",
      "key": "toolSerialNumber",
      "layout": {
        "row": "row_6",
        "col": 8
      },
      "validate": {
        "minLength": 1,
        "maxLength": 50,
        "pattern": "^[A-Za-z0-9\\-]+$"
      }
    },
    {
      "text": "##### Inspection Details",
      "type": "text",
      "id": "Subheading_inspection_details",
      "layout": {
        "row": "row_7",
        "col": 16
      }
    },
    {
      "label": "Inspector Name/ID",
      "type": "textfield",
      "id": "Field_inspectorName",
      "key": "inspectorName",
      "validate": {
        "required": true,
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      },
      "layout": {
        "row": "row_8",
        "col": 16
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Field_inspectionDate",
      "key": "inspectionDate",
      "dateLabel": "Date of Inspection",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_9",
        "col": 8
      }
    },
    {
      "subtype": "time",
      "type": "datetime",
      "id": "Field_inspectionTime",
      "key": "inspectionTime",
      "timeLabel": "Time of Inspection",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_9",
        "col": 8
      },
      "timeInterval": 15
    },
    {
      "text": "##### Condition Assessment",
      "type": "text",
      "id": "Subheading_condition_assessment",
      "layout": {
        "row": "row_10",
        "col": 16
      }
    },
    {
      "label": "Packaging Condition",
      "values": [
        {
          "label": "Original/Intact",
          "value": "original_intact"
        },
        {
          "label": "Damaged",
          "value": "damaged"
        },
        {
          "label": "Missing",
          "value": "missing"
        }
      ],
      "type": "select",
      "id": "Field_packagingCondition",
      "key": "packagingCondition",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_11",
        "col": 5
      }
    },
    {
      "label": "Visual Condition",
      "values": [
        {
          "label": "New",
          "value": "new"
        },
        {
          "label": "Scratched",
          "value": "scratched"
        },
        {
          "label": "Dented",
          "value": "dented"
        },
        {
          "label": "Rusted",
          "value": "rusted"
        },
        {
          "label": "Signs of Heavy Use",
          "value": "heavy_use"
        }
      ],
      "type": "select",
      "id": "Field_visualCondition",
      "key": "visualCondition",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_11",
        "col": 5
      }
    },
    {
      "label": "Functional Test Result",
      "values": [
        {
          "label": "Passed",
          "value": "passed"
        },
        {
          "label": "Failed",
          "value": "failed"
        },
        {
          "label": "Partial Failure",
          "value": "partial_failure"
        }
      ],
      "type": "select",
      "id": "Field_functionalTest",
      "key": "functionalTestResult",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_11",
        "col": 6
      }
    },
    {
      "label": "Missing Components/Accessories",
      "type": "textarea",
      "id": "Field_missingComponents",
      "key": "missingComponents",
      "description": "List any items that are missing.",
      "layout": {
        "row": "row_12",
        "col": 16
      }
    },
    {
      "label": "Notes on Damage/Defects",
      "type": "textarea",
      "id": "Field_damageNotes",
      "key": "damageNotes",
      "layout": {
        "row": "row_13",
        "col": 16
      }
    },
    {
      "label": "Overall Condition Grade",
      "values": [
        {
          "label": "A-Stock / Resalable",
          "value": "a_stock"
        },
        {
          "label": "B-Stock / Refurbish",
          "value": "b_stock"
        },
        {
          "label": "C-Stock / Scrap",
          "value": "c_stock"
        }
      ],
      "type": "select",
      "id": "Field_overallGrade",
      "key": "overallConditionGrade",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_14",
        "col": 16
      }
    },
    {
      "text": "##### Disposition",
      "type": "text",
      "id": "Subheading_disposition",
      "layout": {
        "row": "row_15",
        "col": 16
      }
    },
    {
      "label": "Recommended Action",
      "values": [
        {
          "label": "Return to Inventory",
          "value": "return_to_inventory"
        },
        {
          "label": "Send for Repair",
          "value": "send_for_repair"
        },
        {
          "label": "Scrap",
          "value": "scrap"
        },
        {
          "label": "Return to Customer",
          "value": "return_to_customer"
        }
      ],
      "type": "select",
      "id": "Field_recommendedAction",
      "key": "recommendedAction",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_16",
        "col": 16
      }
    },
    {
      "label": "Reason for Disposition",
      "type": "textarea",
      "id": "Field_dispositionReason",
      "key": "dispositionReason",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_17",
        "col": 16
      }
    },
    {
      "text": "##### Documentation",
      "type": "text",
      "id": "Subheading_documentation",
      "layout": {
        "row": "row_18",
        "col": 16
      }
    },
    {
      "text": "Please upload photos of the tool, packaging, and any damage to the case file separately.",
      "type": "text",
      "id": "Paragraph_photos",
      "layout": {
        "row": "row_19",
        "col": 16
      }
    },
    {
      "text": "##### Signature",
      "type": "text",
      "id": "Subheading_signature",
      "layout": {
        "row": "row_20",
        "col": 16
      }
    },
    {
      "label": "Inspector's Signature (Type Full Name)",
      "type": "textfield",
      "id": "Field_inspectorSignature",
      "key": "inspectorSignature",
      "validate": {
        "required": true,
        "minLength": 2,
        "maxLength": 100
      },
      "layout": {
        "row": "row_21",
        "col": 10
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Field_signatureDate",
      "key": "signatureDate",
      "dateLabel": "Date",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_21",
        "col": 6
      }
    },
    {
      "label": "Submit Inspection",
      "action": "submit",
      "type": "button",
      "id": "Button_submit",
      "layout": {
        "row": "row_22",
        "col": 16
      }
    }
  ],
  "generated": true,
  "type": "default"
}