{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "35a6d3d"
  },
  "schemaVersion": 19,
  "id": "determine-bin-location",
  "components": [
    {
      "text": "### Warehouse Put-Away Form",
      "type": "text",
      "id": "Heading_title",
      "layout": {
        "row": "row_0",
        "col": 16
      }
    },
    {
      "text": "##### Item Information",
      "type": "text",
      "id": "Subheading_itemInfo",
      "layout": {
        "row": "row_1",
        "col": 16
      }
    },
    {
      "label": "Product ID / SKU",
      "type": "textfield",
      "id": "Field_productId",
      "key": "productId",
      "validate": {
        "required": true,
        "minLength": 1,
        "maxLength": 50,
        "pattern": "^[A-Za-z0-9\\-]+$"
      },
      "layout": {
        "row": "row_2",
        "col": 8
      }
    },
    {
      "label": "Lot / Batch Number",
      "type": "textfield",
      "id": "Field_lotNumber",
      "key": "lotNumber",
      "layout": {
        "row": "row_2",
        "col": 8
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "Product Description",
      "type": "textarea",
      "id": "Field_productDescription",
      "key": "productDescription",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_3",
        "col": 16
      }
    },
    {
      "label": "Quantity",
      "type": "number",
      "id": "Field_quantity",
      "key": "quantity",
      "validate": {
        "required": true,
        "min": 1
      },
      "layout": {
        "row": "row_4",
        "col": 5
      }
    },
    {
      "label": "Unit of Measure",
      "values": [
        {
          "label": "Each",
          "value": "each"
        },
        {
          "label": "Case",
          "value": "case"
        },
        {
          "label": "Pallet",
          "value": "pallet"
        }
      ],
      "type": "select",
      "id": "Field_unitOfMeasure",
      "key": "unitOfMeasure",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_4",
        "col": 6
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Field_expirationDate",
      "key": "expirationDate",
      "dateLabel": "Expiration Date",
      "description": "If applicable",
      "layout": {
        "row": "row_4",
        "col": 5
      }
    },
    {
      "text": "##### Physical Characteristics",
      "type": "text",
      "id": "Subheading_physical",
      "layout": {
        "row": "row_5",
        "col": 16
      }
    },
    {
      "label": "Length",
      "type": "number",
      "id": "Field_itemLength",
      "key": "itemLength",
      "appearance": {
        "suffixAdorner": "in"
      },
      "layout": {
        "row": "row_6",
        "col": 3
      }
    },
    {
      "label": "Width",
      "type": "number",
      "id": "Field_itemWidth",
      "key": "itemWidth",
      "appearance": {
        "suffixAdorner": "in"
      },
      "layout": {
        "row": "row_6",
        "col": 3
      }
    },
    {
      "label": "Height",
      "type": "number",
      "id": "Field_itemHeight",
      "key": "itemHeight",
      "appearance": {
        "suffixAdorner": "in"
      },
      "layout": {
        "row": "row_6",
        "col": 3
      }
    },
    {
      "label": "Weight",
      "type": "number",
      "id": "Field_itemWeight",
      "key": "itemWeight",
      "appearance": {
        "suffixAdorner": "lbs"
      },
      "layout": {
        "row": "row_6",
        "col": 3
      }
    },
    {
      "label": "Stackable",
      "values": [
        {
          "label": "Yes",
          "value": "true"
        },
        {
          "label": "No",
          "value": "false"
        }
      ],
      "type": "radio",
      "id": "Field_stackable",
      "key": "stackable",
      "layout": {
        "row": "row_7",
        "col": 8
      }
    },
    {
      "label": "Handling Unit",
      "values": [
        {
          "label": "Pallet",
          "value": "pallet"
        },
        {
          "label": "Carton",
          "value": "carton"
        },
        {
          "label": "Tote",
          "value": "tote"
        }
      ],
      "type": "select",
      "id": "Field_handlingUnit",
      "key": "handlingUnit",
      "layout": {
        "row": "row_7",
        "col": 8
      }
    },
    {
      "text": "##### Storage Requirements",
      "type": "text",
      "id": "Subheading_storage",
      "layout": {
        "row": "row_8",
        "col": 16
      }
    },
    {
      "label": "Storage Zone",
      "values": [
        {
          "label": "Ambient",
          "value": "ambient"
        },
        {
          "label": "Refrigerated",
          "value": "refrigerated"
        },
        {
          "label": "Frozen",
          "value": "frozen"
        },
        {
          "label": "Hazardous Materials",
          "value": "hazmat"
        },
        {
          "label": "High Value",
          "value": "highValue"
        }
      ],
      "type": "select",
      "id": "Field_storageZone",
      "key": "storageZone",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_9",
        "col": 5
      }
    },
    {
      "label": "Required Bin Type",
      "values": [
        {
          "label": "Pallet Rack",
          "value": "palletRack"
        },
        {
          "label": "Shelving",
          "value": "shelving"
        },
        {
          "label": "Bulk Floor",
          "value": "bulkFloor"
        },
        {
          "label": "Cantilever",
          "value": "cantilever"
        }
      ],
      "type": "select",
      "id": "Field_binType",
      "key": "binType",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_9",
        "col": 6
      }
    },
    {
      "label": "Product Velocity",
      "values": [
        {
          "label": "Fast Mover",
          "value": "fast"
        },
        {
          "label": "Medium Mover",
          "value": "medium"
        },
        {
          "label": "Slow Mover",
          "value": "slow"
        }
      ],
      "type": "select",
      "id": "Field_productVelocity",
      "key": "productVelocity",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_9",
        "col": 5
      }
    },
    {
      "text": "##### Inbound Details",
      "type": "text",
      "id": "Subheading_inbound",
      "layout": {
        "row": "row_10",
        "col": 16
      }
    },
    {
      "label": "Inbound Shipment ID / ASN",
      "type": "textfield",
      "id": "Field_inboundShipmentId",
      "key": "inboundShipmentId",
      "validate": {
        "required": true,
        "minLength": 1,
        "maxLength": 50,
        "pattern": "^[A-Za-z0-9\\-]+$"
      },
      "layout": {
        "row": "row_11",
        "col": 6
      }
    },
    {
      "label": "Purchase Order Number",
      "type": "textfield",
      "id": "Field_purchaseOrderNumber",
      "key": "purchaseOrderNumber",
      "validate": {
        "required": true,
        "minLength": 1,
        "maxLength": 50,
        "pattern": "^[A-Za-z0-9\\-]+$"
      },
      "layout": {
        "row": "row_11",
        "col": 6
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Field_dateOfReceipt",
      "key": "dateOfReceipt",
      "dateLabel": "Date of Receipt",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_11",
        "col": 4
      }
    },
    {
      "text": "##### Assignment Details",
      "type": "text",
      "id": "Subheading_assignment",
      "layout": {
        "row": "row_12",
        "col": 16
      }
    },
    {
      "label": "Suggested Bin Location",
      "type": "textfield",
      "id": "Field_suggestedBin",
      "key": "suggestedBin",
      "description": "System generated, if available",
      "layout": {
        "row": "row_13",
        "col": 16
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "Assigned Aisle",
      "type": "textfield",
      "id": "Field_assignedAisle",
      "key": "assignedAisle",
      "validate": {
        "required": true,
        "maxLength": 255
      },
      "layout": {
        "row": "row_14",
        "col": 4
      }
    },
    {
      "label": "Assigned Bay / Rack",
      "type": "textfield",
      "id": "Field_assignedBay",
      "key": "assignedBay",
      "validate": {
        "required": true,
        "maxLength": 255
      },
      "layout": {
        "row": "row_14",
        "col": 4
      }
    },
    {
      "label": "Assigned Level / Shelf",
      "type": "textfield",
      "id": "Field_assignedLevel",
      "key": "assignedLevel",
      "validate": {
        "required": true,
        "maxLength": 255
      },
      "layout": {
        "row": "row_14",
        "col": 4
      }
    },
    {
      "label": "Assigned Bin Position",
      "type": "textfield",
      "id": "Field_assignedPosition",
      "key": "assignedPosition",
      "validate": {
        "required": true,
        "maxLength": 255
      },
      "layout": {
        "row": "row_14",
        "col": 4
      }
    },
    {
      "label": "Put-away Priority",
      "values": [
        {
          "label": "High",
          "value": "high"
        },
        {
          "label": "Normal",
          "value": "normal"
        },
        {
          "label": "Low",
          "value": "low"
        }
      ],
      "type": "select",
      "id": "Field_putawayPriority",
      "key": "putawayPriority",
      "defaultValue": "normal",
      "layout": {
        "row": "row_15",
        "col": 16
      }
    },
    {
      "label": "Special Handling Instructions",
      "type": "textarea",
      "id": "Field_specialInstructions",
      "key": "specialInstructions",
      "layout": {
        "row": "row_16",
        "col": 16
      }
    },
    {
      "text": "##### Approval",
      "type": "text",
      "id": "Subheading_approval",
      "layout": {
        "row": "row_17",
        "col": 16
      }
    },
    {
      "label": "Manager's Name / ID",
      "type": "textfield",
      "id": "Field_managerName",
      "key": "managerName",
      "validate": {
        "required": true,
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      },
      "layout": {
        "row": "row_18",
        "col": 8
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Field_dateOfAssignment",
      "key": "dateOfAssignment",
      "dateLabel": "Date of Assignment",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_18",
        "col": 8
      }
    },
    {
      "label": "Confirmation Signature",
      "type": "textfield",
      "id": "Field_confirmationSignature",
      "key": "confirmationSignature",
      "description": "Type full name to confirm",
      "validate": {
        "required": true,
        "minLength": 2,
        "maxLength": 100
      },
      "layout": {
        "row": "row_19",
        "col": 16
      }
    }
  ],
  "generated": true,
  "type": "default"
}