{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "35a6d3d"
  },
  "schemaVersion": 19,
  "id": "move-items-to-storage-form",
  "components": [
    {
      "text": "### Warehouse Inventory Movement",
      "type": "text",
      "id": "Heading_main",
      "layout": {
        "row": "row_0",
        "col": 16
      }
    },
    {
      "text": "##### Item Details",
      "type": "text",
      "id": "Subheading_item_details",
      "layout": {
        "row": "row_1",
        "col": 16
      }
    },
    {
      "label": "Item ID / SKU",
      "type": "textfield",
      "id": "Textfield_item_id",
      "key": "itemId",
      "validate": {
        "required": true,
        "maxLength": 255
      },
      "layout": {
        "row": "row_2",
        "col": 8
      }
    },
    {
      "label": "Item Description",
      "type": "textfield",
      "id": "Textfield_item_description",
      "key": "itemDescription",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_2",
        "col": 8
      }
    },
    {
      "label": "Quantity Moved",
      "type": "number",
      "id": "Number_quantity",
      "key": "quantityMoved",
      "validate": {
        "required": true,
        "min": 1
      },
      "layout": {
        "row": "row_3",
        "col": 5
      }
    },
    {
      "label": "Unit of Measure",
      "values": [
        {
          "label": "Each",
          "value": "each"
        },
        {
          "label": "Box",
          "value": "box"
        },
        {
          "label": "Pallet",
          "value": "pallet"
        }
      ],
      "type": "select",
      "id": "Select_uom",
      "key": "unitOfMeasure",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_3",
        "col": 5
      }
    },
    {
      "label": "Item Condition",
      "values": [
        {
          "label": "Good",
          "value": "good"
        },
        {
          "label": "Damaged",
          "value": "damaged"
        }
      ],
      "type": "select",
      "id": "Select_condition",
      "key": "itemCondition",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_3",
        "col": 6
      }
    },
    {
      "label": "Lot Number / Batch ID",
      "type": "textfield",
      "id": "Textfield_lot_number",
      "key": "lotNumber",
      "layout": {
        "row": "row_4",
        "col": 8
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "Serial Number(s)",
      "values": [
        {
          "label": "Value",
          "value": "value"
        }
      ],
      "type": "taglist",
      "id": "Taglist_serial_numbers",
      "key": "serialNumbers",
      "description": "Press enter after each serial number.",
      "layout": {
        "row": "row_5",
        "col": 16
      }
    },
    {
      "text": "##### Location Information",
      "type": "text",
      "id": "Subheading_location",
      "layout": {
        "row": "row_6",
        "col": 16
      }
    },
    {
      "label": "Origin Location",
      "type": "textfield",
      "id": "Textfield_origin",
      "key": "originLocation",
      "description": "e.g., Receiving Dock, Aisle/Bay/Shelf ID",
      "validate": {
        "required": true,
        "maxLength": 255
      },
      "layout": {
        "row": "row_7",
        "col": 8
      }
    },
    {
      "label": "Destination Location",
      "type": "textfield",
      "id": "Textfield_destination",
      "key": "destinationLocation",
      "description": "e.g., Aisle/Bay/Shelf ID",
      "validate": {
        "required": true,
        "maxLength": 255
      },
      "layout": {
        "row": "row_7",
        "col": 8
      }
    },
    {
      "text": "##### Movement Execution",
      "type": "text",
      "id": "Subheading_execution",
      "layout": {
        "row": "row_8",
        "col": 16
      }
    },
    {
      "label": "Warehouse Staff Name / ID",
      "type": "textfield",
      "id": "Textfield_staff_id",
      "key": "staffId",
      "validate": {
        "required": true,
        "maxLength": 255
      },
      "layout": {
        "row": "row_9",
        "col": 8
      }
    },
    {
      "subtype": "datetime",
      "type": "datetime",
      "id": "Datetime_move",
      "key": "moveTimestamp",
      "dateLabel": "Date of Move",
      "timeLabel": "Time of Move",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_9",
        "col": 8
      },
      "timeInterval": 15
    },
    {
      "label": "Equipment Used",
      "values": [
        {
          "label": "Forklift",
          "value": "forklift"
        },
        {
          "label": "Pallet Jack",
          "value": "pallet_jack"
        },
        {
          "label": "Cart",
          "value": "cart"
        },
        {
          "label": "Manual",
          "value": "manual"
        }
      ],
      "type": "select",
      "id": "Select_equipment",
      "key": "equipmentUsed",
      "layout": {
        "row": "row_10",
        "col": 16
      }
    },
    {
      "text": "##### Confirmation",
      "type": "text",
      "id": "Subheading_confirmation",
      "layout": {
        "row": "row_11",
        "col": 16
      }
    },
    {
      "label": "Notes / Comments",
      "type": "textarea",
      "id": "Textarea_notes",
      "key": "notes",
      "layout": {
        "row": "row_12",
        "col": 16
      }
    },
    {
      "label": "Staff Signature",
      "type": "textfield",
      "id": "Textfield_signature",
      "key": "staffSignature",
      "description": "Type full name to sign.",
      "validate": {
        "required": true,
        "minLength": 2,
        "maxLength": 100
      },
      "layout": {
        "row": "row_13",
        "col": 8
      }
    },
    {
      "subtype": "datetime",
      "type": "datetime",
      "id": "Datetime_completion",
      "key": "completionTimestamp",
      "dateLabel": "Completion Date",
      "timeLabel": "Completion Time",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_13",
        "col": 8
      },
      "timeInterval": 15
    },
    {
      "label": "Complete Movement",
      "action": "submit",
      "type": "button",
      "id": "Button_submit",
      "layout": {
        "row": "row_14",
        "col": 16
      }
    }
  ],
  "generated": true,
  "type": "default"
}