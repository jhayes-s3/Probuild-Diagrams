{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "35a6d3d"
  },
  "schemaVersion": 19,
  "id": "check-and-inspect-goods-form",
  "components": [
    {
      "text": "### Goods Receipt Inspection Report",
      "type": "text",
      "id": "Heading_title",
      "layout": {
        "row": "row_00",
        "col": 16
      }
    },
    {
      "text": "### Shipment Information",
      "type": "text",
      "id": "Heading_shipment",
      "layout": {
        "row": "row_01",
        "col": 16
      }
    },
    {
      "label": "Purchase Order Number",
      "type": "textfield",
      "id": "Field_poNumber",
      "key": "poNumber",
      "validate": {
        "required": true,
        "maxLength": 255
      },
      "layout": {
        "row": "row_02",
        "col": 8
      }
    },
    {
      "label": "Supplier Name",
      "type": "textfield",
      "id": "Field_supplierName",
      "key": "supplierName",
      "validate": {
        "required": true,
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      },
      "layout": {
        "row": "row_02",
        "col": 8
      }
    },
    {
      "label": "Delivery Note Number",
      "type": "textfield",
      "id": "Field_deliveryNote",
      "key": "deliveryNoteNumber",
      "layout": {
        "row": "row_03",
        "col": 8
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Field_receiptDate",
      "key": "dateOfReceipt",
      "dateLabel": "Date of Receipt",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_03",
        "col": 8
      }
    },
    {
      "label": "Receiving Bay/Location",
      "type": "textfield",
      "id": "Field_receivingBay",
      "key": "receivingBayLocation",
      "layout": {
        "row": "row_04",
        "col": 16
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "text": "### Product Details",
      "type": "text",
      "id": "Heading_product",
      "layout": {
        "row": "row_05",
        "col": 16
      }
    },
    {
      "label": "Product SKU / Item Code",
      "type": "textfield",
      "id": "Field_productSku",
      "key": "productSku",
      "validate": {
        "required": true,
        "minLength": 1,
        "maxLength": 50,
        "pattern": "^[A-Za-z0-9\\-]+$"
      },
      "layout": {
        "row": "row_06",
        "col": 8
      }
    },
    {
      "label": "Batch / Lot Number",
      "type": "textfield",
      "id": "Field_batchNumber",
      "key": "batchLotNumber",
      "layout": {
        "row": "row_06",
        "col": 8
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "Product Description",
      "type": "textarea",
      "id": "Field_productDescription",
      "key": "productDescription",
      "layout": {
        "row": "row_07",
        "col": 16
      }
    },
    {
      "label": "Expected Quantity",
      "type": "number",
      "id": "Field_expectedQty",
      "key": "expectedQuantity",
      "validate": {
        "required": true,
        "min": 0
      },
      "layout": {
        "row": "row_08",
        "col": 5
      }
    },
    {
      "label": "Received Quantity",
      "type": "number",
      "id": "Field_receivedQty",
      "key": "receivedQuantity",
      "validate": {
        "required": true,
        "min": 0
      },
      "layout": {
        "row": "row_08",
        "col": 5
      }
    },
    {
      "label": "Unit of Measure",
      "values": [
        {
          "label": "Pieces",
          "value": "pieces"
        },
        {
          "label": "Kilograms (kg)",
          "value": "kg"
        },
        {
          "label": "Liters (l)",
          "value": "liters"
        },
        {
          "label": "Boxes",
          "value": "boxes"
        }
      ],
      "type": "select",
      "id": "Field_uom",
      "key": "unitOfMeasure",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_08",
        "col": 6
      }
    },
    {
      "label": "Serial Numbers (if applicable)",
      "values": [
        {
          "label": "Value",
          "value": "value"
        }
      ],
      "type": "taglist",
      "id": "Field_serialNumbers",
      "key": "serialNumbers",
      "description": "Press Enter to add a new serial number.",
      "layout": {
        "row": "row_09",
        "col": 16
      }
    },
    {
      "text": "### Inspection Details",
      "type": "text",
      "id": "Heading_inspection",
      "layout": {
        "row": "row_10",
        "col": 16
      }
    },
    {
      "label": "Inspector Name / ID",
      "type": "textfield",
      "id": "Field_inspectorName",
      "key": "inspectorName",
      "validate": {
        "required": true,
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      },
      "layout": {
        "row": "row_11",
        "col": 8
      }
    },
    {
      "subtype": "datetime",
      "type": "datetime",
      "id": "Field_inspectionDateTime",
      "key": "inspectionDateTime",
      "dateLabel": "Inspection Date",
      "timeLabel": "Time",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_11",
        "col": 8
      },
      "timeInterval": 15
    },
    {
      "label": "Inspection Type",
      "values": [
        {
          "label": "Visual",
          "value": "visual"
        },
        {
          "label": "Dimensional",
          "value": "dimensional"
        },
        {
          "label": "Functional",
          "value": "functional"
        }
      ],
      "type": "select",
      "id": "Field_inspectionType",
      "key": "inspectionType",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_12",
        "col": 16
      }
    },
    {
      "text": "### Inspection Checklist/Results",
      "type": "text",
      "id": "Heading_checklist",
      "layout": {
        "row": "row_13",
        "col": 16
      }
    },
    {
      "label": "Check Item",
      "values": [
        {
          "label": "Packaging Condition",
          "value": "packaging"
        },
        {
          "label": "Correct Labeling",
          "value": "labeling"
        },
        {
          "label": "No Physical Damage",
          "value": "damage"
        }
      ],
      "type": "select",
      "id": "Field_checkItem",
      "key": "checkItem",
      "layout": {
        "row": "row_14",
        "col": 8
      }
    },
    {
      "label": "Status",
      "values": [
        {
          "label": "Pass",
          "value": "pass"
        },
        {
          "label": "Fail",
          "value": "fail"
        },
        {
          "label": "N/A",
          "value": "na"
        }
      ],
      "type": "radio",
      "id": "Field_checkStatus",
      "key": "checkStatus",
      "layout": {
        "row": "row_14",
        "col": 8
      }
    },
    {
      "label": "Measurement/Value (if applicable)",
      "type": "textfield",
      "id": "Field_checkMeasurement",
      "key": "checkMeasurement",
      "layout": {
        "row": "row_15",
        "col": 16
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "Comments per Check Item",
      "type": "textarea",
      "id": "Field_checkComments",
      "key": "checkComments",
      "layout": {
        "row": "row_16",
        "col": 16
      }
    },
    {
      "text": "### Summary & Disposition",
      "type": "text",
      "id": "Heading_summary",
      "layout": {
        "row": "row_17",
        "col": 16
      }
    },
    {
      "label": "Total Qty Inspected",
      "type": "number",
      "id": "Field_totalInspected",
      "key": "totalInspected",
      "validate": {
        "required": true,
        "min": 0
      },
      "layout": {
        "row": "row_18",
        "col": 5
      }
    },
    {
      "label": "Quantity Accepted",
      "type": "number",
      "id": "Field_qtyAccepted",
      "key": "quantityAccepted",
      "validate": {
        "required": true,
        "min": 0
      },
      "layout": {
        "row": "row_18",
        "col": 5
      }
    },
    {
      "label": "Quantity Rejected",
      "type": "number",
      "id": "Field_qtyRejected",
      "key": "quantityRejected",
      "validate": {
        "required": true,
        "min": 0
      },
      "layout": {
        "row": "row_18",
        "col": 6
      }
    },
    {
      "label": "Reason for Rejection",
      "values": [
        {
          "label": "Damaged",
          "value": "damaged"
        },
        {
          "label": "Incorrect Specification",
          "value": "incorrect_spec"
        },
        {
          "label": "Contamination",
          "value": "contamination"
        },
        {
          "label": "Shortage/Overage",
          "value": "quantity_mismatch"
        }
      ],
      "type": "select",
      "id": "Field_rejectionReason",
      "key": "rejectionReason",
      "description": "Required if Quantity Rejected > 0",
      "layout": {
        "row": "row_19",
        "col": 8
      }
    },
    {
      "label": "Overall Inspection Status",
      "values": [
        {
          "label": "Approved",
          "value": "approved"
        },
        {
          "label": "Rejected",
          "value": "rejected"
        },
        {
          "label": "Approved with Concession",
          "value": "concession"
        }
      ],
      "type": "radio",
      "id": "Field_overallStatus",
      "key": "overallStatus",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_19",
        "col": 8
      }
    },
    {
      "label": "Detailed Notes/Observations",
      "type": "textarea",
      "id": "Field_detailedNotes",
      "key": "detailedNotes",
      "layout": {
        "row": "row_20",
        "col": 16
      }
    },
    {
      "text": "Photo evidence of defects (if any) should be uploaded to the corresponding case file.",
      "type": "text",
      "id": "Paragraph_photo",
      "layout": {
        "row": "row_21",
        "col": 16
      }
    },
    {
      "text": "### Sign-off",
      "type": "text",
      "id": "Heading_signoff",
      "layout": {
        "row": "row_22",
        "col": 16
      }
    },
    {
      "label": "Inspector's Signature (type full name)",
      "type": "textfield",
      "id": "Field_inspectorSignature",
      "key": "inspectorSignature",
      "validate": {
        "required": true,
        "minLength": 2,
        "maxLength": 100
      },
      "layout": {
        "row": "row_23",
        "col": 8
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Field_signatureDate",
      "key": "signatureDate",
      "dateLabel": "Date of Signature",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_23",
        "col": 8
      }
    }
  ],
  "generated": true,
  "type": "default"
}