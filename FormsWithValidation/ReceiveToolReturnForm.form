{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "35a6d3d"
  },
  "schemaVersion": 19,
  "id": "receive-tool-return-form",
  "components": [
    {
      "text": "### Tool Return Form",
      "type": "text",
      "id": "Form-heading-main",
      "layout": {
        "row": "row-00",
        "col": 16
      }
    },
    {
      "text": "##### Tool Information",
      "type": "text",
      "id": "Subheading-tool-info",
      "layout": {
        "row": "row-01",
        "col": 16
      }
    },
    {
      "label": "Tool ID / Asset Number",
      "type": "textfield",
      "id": "Field-tool-id",
      "key": "toolId",
      "validate": {
        "required": true,
        "minLength": 1,
        "maxLength": 50,
        "pattern": "^[A-Za-z0-9\\-]+$"
      },
      "layout": {
        "row": "row-02",
        "col": 8
      }
    },
    {
      "label": "Tool Name / Description",
      "type": "textfield",
      "id": "Field-tool-name",
      "key": "toolName",
      "validate": {
        "required": true,
        "maxLength": 255
      },
      "layout": {
        "row": "row-02",
        "col": 8
      }
    },
    {
      "label": "Serial Number",
      "type": "textfield",
      "id": "Field-serial-number",
      "key": "serialNumber",
      "layout": {
        "row": "row-03",
        "col": 16
      },
      "validate": {
        "minLength": 1,
        "maxLength": 50,
        "pattern": "^[A-Za-z0-9\\-]+$"
      }
    },
    {
      "text": "##### Returner Information",
      "type": "text",
      "id": "Subheading-returner-info",
      "layout": {
        "row": "row-04",
        "col": 16
      }
    },
    {
      "label": "Employee / Customer Name",
      "type": "textfield",
      "id": "Field-returner-name",
      "key": "returnerName",
      "validate": {
        "required": true,
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      },
      "layout": {
        "row": "row-05",
        "col": 8
      }
    },
    {
      "label": "Employee ID / Customer Account Number",
      "type": "textfield",
      "id": "Field-returner-id",
      "key": "returnerId",
      "layout": {
        "row": "row-05",
        "col": 8
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "Department / Company Name",
      "type": "textfield",
      "id": "Field-department",
      "key": "department",
      "layout": {
        "row": "row-06",
        "col": 8
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "Contact Phone Number",
      "type": "textfield",
      "id": "Field-contact-phone",
      "key": "contactPhone",
      "layout": {
        "row": "row-06",
        "col": 8
      },
      "validate": {
        "pattern": "^[\\+]?[\\d\\s\\-\\(\\)]{7,15}$",
        "maxLength": 255
      }
    },
    {
      "text": "##### Transaction Details",
      "type": "text",
      "id": "Subheading-transaction-details",
      "layout": {
        "row": "row-07",
        "col": 16
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Field-checkout-date",
      "key": "checkoutDate",
      "dateLabel": "Original Checkout Date",
      "layout": {
        "row": "row-08",
        "col": 8
      }
    },
    {
      "label": "Original Checkout Reference Number",
      "type": "textfield",
      "id": "Field-checkout-ref",
      "key": "checkoutRef",
      "layout": {
        "row": "row-08",
        "col": 8
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Field-return-date",
      "key": "returnDate",
      "dateLabel": "Return Date",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row-09",
        "col": 8
      }
    },
    {
      "subtype": "time",
      "type": "datetime",
      "id": "Field-return-time",
      "key": "returnTime",
      "timeLabel": "Return Time",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row-09",
        "col": 8
      },
      "timeInterval": 15
    },
    {
      "text": "##### Condition Assessment",
      "type": "text",
      "id": "Subheading-condition",
      "layout": {
        "row": "row-10",
        "col": 16
      }
    },
    {
      "label": "Condition on Return",
      "values": [
        {
          "label": "Good",
          "value": "good"
        },
        {
          "label": "Fair",
          "value": "fair"
        },
        {
          "label": "Damaged",
          "value": "damaged"
        },
        {
          "label": "Needs Repair",
          "value": "needs_repair"
        }
      ],
      "type": "select",
      "id": "Field-condition",
      "key": "conditionOnReturn",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row-11",
        "col": 8
      }
    },
    {
      "label": "All Accessories Returned?",
      "values": [
        {
          "label": "Yes",
          "value": "yes"
        },
        {
          "label": "No",
          "value": "no"
        }
      ],
      "type": "radio",
      "id": "Field-accessories-returned",
      "key": "accessoriesReturned",
      "layout": {
        "row": "row-11",
        "col": 8
      }
    },
    {
      "label": "Notes on Condition / Damage Description",
      "type": "textarea",
      "id": "Field-condition-notes",
      "key": "conditionNotes",
      "layout": {
        "row": "row-12",
        "col": 16
      }
    },
    {
      "label": "List of Missing Accessories",
      "type": "textarea",
      "id": "Field-missing-accessories",
      "key": "missingAccessories",
      "description": "Only required if 'All Accessories Returned?' is No.",
      "layout": {
        "row": "row-13",
        "col": 16
      }
    },
    {
      "text": "##### Processing (Internal Use)",
      "type": "text",
      "id": "Subheading-processing",
      "layout": {
        "row": "row-14",
        "col": 16
      }
    },
    {
      "label": "Received By (Employee Name)",
      "type": "textfield",
      "id": "Field-received-by",
      "key": "receivedBy",
      "validate": {
        "required": true,
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      },
      "layout": {
        "row": "row-15",
        "col": 8
      }
    },
    {
      "label": "Action Taken",
      "values": [
        {
          "label": "Returned to Stock",
          "value": "stock"
        },
        {
          "label": "Sent for Repair",
          "value": "repair"
        },
        {
          "label": "Scrapped",
          "value": "scrapped"
        }
      ],
      "type": "select",
      "id": "Field-action-taken",
      "key": "actionTaken",
      "layout": {
        "row": "row-15",
        "col": 8
      }
    },
    {
      "label": "New Storage Location",
      "type": "textfield",
      "id": "Field-storage-location",
      "key": "newStorageLocation",
      "layout": {
        "row": "row-16",
        "col": 8
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "Repair Order Number (if applicable)",
      "type": "textfield",
      "id": "Field-repair-order",
      "key": "repairOrderNumber",
      "layout": {
        "row": "row-16",
        "col": 8
      },
      "validate": {
        "minLength": 1,
        "maxLength": 50,
        "pattern": "^[A-Za-z0-9\\-]+$"
      }
    },
    {
      "text": "##### Signatures",
      "type": "text",
      "id": "Subheading-signatures",
      "layout": {
        "row": "row-17",
        "col": 16
      }
    },
    {
      "label": "Returner's Signature (type name)",
      "type": "textfield",
      "id": "Field-returner-signature",
      "key": "returnerSignature",
      "validate": {
        "required": true,
        "minLength": 2,
        "maxLength": 100
      },
      "layout": {
        "row": "row-18",
        "col": 8
      }
    },
    {
      "label": "Receiver's Signature (type name)",
      "type": "textfield",
      "id": "Field-receiver-signature",
      "key": "receiverSignature",
      "validate": {
        "required": true,
        "minLength": 2,
        "maxLength": 100
      },
      "layout": {
        "row": "row-18",
        "col": 8
      }
    },
    {
      "label": "Submit Return",
      "action": "submit",
      "type": "button",
      "id": "Button-submit",
      "layout": {
        "row": "row-19",
        "col": 16
      }
    }
  ],
  "generated": true,
  "type": "default"
}