      }
    },
    {
      "label": "Tool Location (Zone)",
      "type": "textfield",
      "id": "Field-location-zone",
      "key": "toolLocationZone",
      "layout": {
        "row": "row-3",
        "col": 6
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "text": "### Inspection Details",
