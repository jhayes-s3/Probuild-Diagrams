          "label": "Pass",
          "value": "pass"
        },
        {
          "label": "Fail",
          "value": "fail"
        },
        {
          "label": "Requires Maintenance",
          "value": "maintenance"
        }
      ],
      "type": "select",
      "id": "Field-inspection-result",
      "key": "inspectionResult",
      "validate": {
        "required": true
      },
