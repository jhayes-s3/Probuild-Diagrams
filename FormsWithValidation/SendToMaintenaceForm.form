      "layout": {
        "row": "row-3",
        "col": 5
      },
      "validate": {
        "maxLength": 60,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-_/# ]{1,59}$",
        "minLength": 2
      }
    },
    {
      "label": "Tool Location (Bay)",
      "type": "textfield",
      "id": "Field-location-bay",
