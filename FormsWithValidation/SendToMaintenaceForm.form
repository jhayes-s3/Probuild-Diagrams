  "components": [
    {
      "text": "### Tool Inspection & Maintenance Report",
      "type": "text",
      "id": "Form-heading-main",
      "layout": {
        "row": "row-0",
        "col": 16
      }
    },
    {
      "text": "### Tool Identification",
      "type": "text",
      "id": "Heading-tool-id",
      "level": 2,
      "layout": {
        "row": "row-1",
        "col": 16
      }
    },
    {
      "label": "Tool Name",
      "type": "textfield",
      "id": "Field-tool-name",
      "key": "toolName",
      "validate": {
        "required": true,
        "maxLength": 255,
        "minLength": 2
      },
      "layout": {
        "row": "row-2",
        "col": 8
      }
    },
    {
      "label": "Tool ID / Asset Tag Number",
      "type": "textfield",
      "id": "Field-tool-id",
      "key": "toolId",
      "validate": {
        "required": true,
        "maxLength": 60,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-_/# ]{1,59}$",
        "minLength": 2
      },
      "layout": {
        "row": "row-2",
        "col": 8
      }
    },
    {
      "label": "Tool Location (Aisle)",
      "type": "textfield",
