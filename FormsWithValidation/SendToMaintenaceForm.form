      "id": "Field-inspected-by",
      "key": "inspectedBy",
      "validate": {
        "required": true,
        "maxLength": 255,
        "pattern": "^[A-Za-z][A-Za-z\\s\\-']{1,99}$",
        "minLength": 2
      },
      "layout": {
        "row": "row-5",
        "col": 8
