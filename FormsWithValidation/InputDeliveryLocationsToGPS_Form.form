{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "35a6d3d"
  },
  "schemaVersion": 19,
  "id": "input-delivery-locations-to-GPS-form",
  "components": [
    {
      "text": "### New Delivery Request",
      "type": "text",
      "id": "Form_Heading_NewDelivery",
      "layout": {
        "row": "row-0",
        "col": 16
      }
    },
    {
      "text": "### Destination Address",
      "type": "text",
      "id": "Form_Heading_DestinationAddress",
      "level": "2",
      "layout": {
        "row": "row-1",
        "col": 16
      }
    },
    {
      "label": "Street Number and Name",
      "type": "textfield",
      "id": "Field_StreetAddress",
      "key": "streetAddress",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row-2",
        "col": 10
      }
    },
    {
      "label": "Apartment/Suite/Unit",
      "type": "textfield",
      "id": "Field_AptSuite",
      "key": "aptSuite",
      "layout": {
        "row": "row-2",
        "col": 6
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "City",
      "type": "textfield",
      "id": "Field_City",
      "key": "city",
      "validate": {
        "required": true,
        "maxLength": 50,
        "pattern": "^[A-Za-z\\s\\-']+$"
      },
      "layout": {
        "row": "row-3",
        "col": 6
      }
    },
    {
      "label": "State/Province",
      "type": "textfield",
      "id": "Field_State",
      "key": "state",
      "validate": {
        "required": true,
        "minLength": 2,
        "maxLength": 2,
        "pattern": "^[A-Z]{2}$"
      },
      "layout": {
        "row": "row-3",
        "col": 5
      }
    },
    {
      "label": "Postal/ZIP Code",
      "type": "textfield",
      "id": "Field_PostalCode",
      "key": "postalCode",
      "validate": {
        "required": true,
        "pattern": "^\\d{5}(\\-\\d{4})?$",
        "maxLength": 255
      },
      "layout": {
        "row": "row-3",
        "col": 5
      }
    },
    {
      "label": "Country",
      "type": "textfield",
      "id": "Field_Country",
      "key": "country",
      "validate": {
        "required": true,
        "maxLength": 255
      },
      "layout": {
        "row": "row-4",
        "col": 16
      }
    },
    {
      "text": "### Recipient Information",
      "type": "text",
      "id": "Form_Heading_RecipientInfo",
      "level": "2",
      "layout": {
        "row": "row-5",
        "col": 16
      }
    },
    {
      "label": "Recipient Full Name",
      "type": "textfield",
      "id": "Field_RecipientName",
      "key": "recipientName",
      "validate": {
        "required": true,
        "pattern": "^[A-Za-z\\s\\-']+$",
        "maxLength": 100
      },
      "layout": {
        "row": "row-6",
        "col": 8
      }
    },
    {
      "label": "Recipient Contact Phone",
      "type": "textfield",
      "id": "Field_RecipientPhone",
      "key": "recipientPhone",
      "validate": {
        "required": true,
        "pattern": "^[\\+]?[\\d\\s\\-\\(\\)]{7,15}$",
        "maxLength": 255
      },
      "layout": {
        "row": "row-6",
        "col": 8
      }
    },
    {
      "text": "### Delivery Details",
      "type": "text",
      "id": "Form_Heading_DeliveryDetails",
      "level": "2",
      "layout": {
        "row": "row-7",
        "col": 16
      }
    },
    {
      "label": "Order ID / Shipment ID",
      "type": "textfield",
      "id": "Field_OrderId",
      "key": "orderId",
      "validate": {
        "required": true,
        "minLength": 1,
        "maxLength": 50,
        "pattern": "^[A-Za-z0-9\\-]+$"
      },
      "layout": {
        "row": "row-8",
        "col": 16
      }
    },
    {
      "label": "Delivery Instructions",
      "type": "textarea",
      "id": "Field_DeliveryInstructions",
      "key": "deliveryInstructions",
      "description": "e.g., gate code, leave with doorman",
      "layout": {
        "row": "row-9",
        "col": 16
      }
    },
    {
      "subtype": "time",
      "type": "datetime",
      "id": "Field_DeliveryWindowStart",
      "key": "deliveryWindowStart",
      "timeLabel": "Scheduled Delivery Start",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row-10",
        "col": 8
      },
      "timeInterval": 15
    },
    {
      "subtype": "time",
      "type": "datetime",
      "id": "Field_DeliveryWindowEnd",
      "key": "deliveryWindowEnd",
      "timeLabel": "Scheduled Delivery End",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row-10",
        "col": 8
      },
      "timeInterval": 15
    },
    {
      "text": "### Geospatial Data",
      "type": "text",
      "id": "Form_Heading_Geospatial",
      "level": "2",
      "layout": {
        "row": "row-11",
        "col": 16
      }
    },
    {
      "label": "Latitude",
      "type": "number",
      "id": "Field_Latitude",
      "key": "latitude",
      "decimalDigits": 6,
      "validate": {
        "required": true,
        "min": -90,
        "max": 90
      },
      "layout": {
        "row": "row-12",
        "col": 8
      }
    },
    {
      "label": "Longitude",
      "type": "number",
      "id": "Field_Longitude",
      "key": "longitude",
      "decimalDigits": 6,
      "validate": {
        "required": true,
        "min": -180,
        "max": 180
      },
      "layout": {
        "row": "row-12",
        "col": 8
      }
    },
    {
      "label": "Submit Delivery Request",
      "action": "submit",
      "type": "button",
      "id": "Button_Submit",
      "layout": {
        "row": "row-13",
        "col": 16
      }
    }
  ],
  "generated": true,
  "type": "default"
}