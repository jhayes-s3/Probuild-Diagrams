{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "35a6d3d"
  },
  "schemaVersion": 19,
  "id": "request-finance-option-at-checkout-form",
  "components": [
    {
      "text": "### Personal Information",
      "type": "text",
      "id": "Heading_personal_info",
      "layout": {
        "row": "row_0",
        "col": 16
      }
    },
    {
      "label": "First Name",
      "type": "textfield",
      "id": "Field_firstName",
      "key": "firstName",
      "validate": {
        "required": true,
        "maxLength": 255,
        "pattern": "^[A-Za-z][A-Za-z\\s\\-']{1,99}$",
        "minLength": 2
      },
      "layout": {
        "row": "row_1",
        "col": 8
      }
    },
    {
      "label": "Last Name",
      "type": "textfield",
      "id": "Field_lastName",
      "key": "lastName",
      "validate": {
        "required": true,
        "maxLength": 255,
        "pattern": "^[A-Za-z][A-Za-z\\s\\-']{1,99}$",
        "minLength": 2
      },
      "layout": {
        "row": "row_1",
        "col": 8
      }
    },
    {
      "subtype": "date",
      "type": "datetime",
      "id": "Field_dob",
      "key": "dateOfBirth",
      "dateLabel": "Date of Birth",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_2",
        "col": 16
      }
    },
    {
      "label": "Social Security Number / National ID",
      "type": "textfield",
      "id": "Field_ssn",
      "key": "nationalId",
      "validate": {
        "required": true,
        "maxLength": 60,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-_/# ]{1,59}$",
        "minLength": 2
      },
      "layout": {
        "row": "row_3",
        "col": 16
      }
    },
    {
      "text": "### Contact Information",
      "type": "text",
      "id": "Heading_contact_info",
      "layout": {
        "row": "row_4",
        "col": 16
      }
    },
    {
      "label": "Email Address",
      "type": "textfield",
      "id": "Field_email",
      "key": "email",
      "validate": {
        "required": true,
        "maxLength": 255,
        "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
      },
      "layout": {
        "row": "row_5",
        "col": 8
      }
    },
    {
      "label": "Mobile Phone Number",
      "type": "textfield",
      "id": "Field_mobile",
      "key": "mobilePhone",
      "validate": {
        "required": true,
        "maxLength": 20,
        "pattern": "^[+]?[0-9\\s()\\-]{7,20}$",
        "minLength": 7
      },
      "layout": {
        "row": "row_5",
        "col": 8
      }
    },
    {
      "label": "Street Address",
      "type": "textfield",
      "id": "Field_street",
      "key": "addressStreet",
      "validate": {
        "required": true,
        "maxLength": 500,
        "minLength": 5
      },
      "layout": {
        "row": "row_6",
        "col": 16
      }
    },
    {
      "label": "City",
      "type": "textfield",
      "id": "Field_city",
      "key": "addressCity",
      "validate": {
        "required": true,
        "maxLength": 500,
        "minLength": 5
      },
      "layout": {
        "row": "row_7",
        "col": 6
      }
    },
    {
      "label": "State",
      "type": "textfield",
      "id": "Field_state",
      "key": "addressState",
      "validate": {
        "required": true,
        "maxLength": 500,
        "minLength": 5
      },
      "layout": {
        "row": "row_7",
        "col": 4
      }
    },
    {
      "label": "ZIP Code",
      "type": "textfield",
      "id": "Field_zip",
      "key": "addressZip",
      "validate": {
        "required": true,
        "maxLength": 12,
        "pattern": "^[A-Za-z0-9\\s\\-]{3,12}$",
        "minLength": 3
      },
      "layout": {
        "row": "row_7",
        "col": 6
      }
    },
    {
      "text": "### Financial Information",
      "type": "text",
      "id": "Heading_financial_info",
      "layout": {
        "row": "row_8",
        "col": 16
      }
    },
    {
      "label": "Employment Status",
      "values": [
        {
          "label": "Employed",
          "value": "employed"
        },
        {
          "label": "Self-Employed",
          "value": "self_employed"
        },
        {
          "label": "Unemployed",
          "value": "unemployed"
        },
        {
          "label": "Student",
          "value": "student"
        },
        {
          "label": "Retired",
          "value": "retired"
        }
      ],
      "type": "select",
      "id": "Field_employmentStatus",
      "key": "employmentStatus",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_9",
        "col": 8
      }
    },
    {
      "label": "Employer Name",
      "type": "textfield",
      "id": "Field_employerName",
      "key": "employerName",
      "layout": {
        "row": "row_9",
        "col": 8
      },
      "validate": {
        "maxLength": 255
      }
    },
    {
      "label": "Annual Income",
      "type": "number",
      "id": "Field_annualIncome",
      "key": "annualIncome",
      "appearance": {
        "prefixAdorner": "$"
      },
      "validate": {
        "required": true,
        "min": 0,
        "max": 100000000
      },
      "layout": {
        "row": "row_10",
        "col": 16
      }
    },
    {
      "text": "### Order Information",
      "type": "text",
      "id": "Heading_order_info",
      "layout": {
        "row": "row_11",
        "col": 16
      }
    },
    {
      "label": "Total Purchase Amount",
      "type": "number",
      "id": "Field_purchaseAmount",
      "key": "purchaseAmount",
      "appearance": {
        "prefixAdorner": "$"
      },
      "validate": {
        "required": true,
        "min": 0,
        "max": 100000000
      },
      "layout": {
        "row": "row_12",
        "col": 16
      }
    },
    {
      "text": "### Agreements",
      "type": "text",
      "id": "Heading_agreements",
      "layout": {
        "row": "row_13",
        "col": 16
      }
    },
    {
      "label": "I consent to a credit check.",
      "type": "checkbox",
      "id": "Field_creditCheck",
      "key": "consentCreditCheck",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_14",
        "col": 16
      }
    },
    {
      "label": "I agree to the Terms and Conditions.",
      "type": "checkbox",
      "id": "Field_terms",
      "key": "agreeTerms",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_15",
        "col": 16
      }
    },
    {
      "label": "I agree to the Privacy Policy.",
      "type": "checkbox",
      "id": "Field_privacy",
      "key": "agreePrivacy",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "row_16",
        "col": 16
      }
    },
    {
      "label": "Submit",
      "action": "submit",
      "type": "button",
      "id": "Button_submit",
      "layout": {
        "row": "row_17",
        "col": 16
      }
    }
  ],
  "generated": true,
  "type": "default"
}